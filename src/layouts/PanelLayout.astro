---
import '@/styles/global.css';
import { Home, Users, Inbox, Settings, LogOut, Route, CalendarDays, ChartColumn } from 'lucide-react';
import AutomaticVisitStatus from '@/components/panel/AutomaticVisitStatus';
import VoiceConversation from '@/components/panel/VoiceConversation';

interface Props {
    title: string;
    description?: string;
}

const { title } = Astro.props;

const path = Astro.url.pathname;
const userEmail = Astro.locals.user?.email ?? '';
const initial = (userEmail[0] ?? 'J').toUpperCase();

const items = [
    { href: '/panel', label: 'Hoy', icon: Home, exact: true },
    { href: '/panel/agenda', label: 'Agenda', icon: CalendarDays, exact: false },
    { href: '/panel/ruta', label: 'Ruta', icon: Route, exact: false },
    { href: '/panel/reportes', label: 'Reportes', icon: ChartColumn, exact: false },
    { href: '/panel/clientes', label: 'Clientes', icon: Users, exact: false },
    { href: '/panel/leads', label: 'Leads', icon: Inbox, exact: false },
    { href: '/panel/ajustes', label: 'Ajustes', icon: Settings, exact: false },
];

// Leads queda en el escritorio; el reporte semanal también es accesible desde el teléfono.
const mobileItems = items.filter((item) => item.href !== '/panel/leads');

const isActive = (href: string, exact: boolean) =>
    exact ? path === href : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <link rel="icon" type="image/png" href="/brand-icon-64.png" />
        <meta name="robots" content="noindex, nofollow" />
        <meta name="theme-color" content="#ffffff" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <link rel="apple-touch-icon" href="/brand-icon-180.png" />
        <title>{title} | Panel JyM</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
        <div id="panel-navigation-status" role="status" aria-live="polite"
            class="fixed inset-x-4 top-3 z-50 mx-auto hidden max-w-md rounded-xl border border-sky-200 bg-white px-4 py-3 text-sm font-bold text-sky-900 shadow-lg">
            <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-sky-200 border-t-sky-700 align-middle" aria-hidden="true"></span>
            <span class="ml-2" data-message>Abriendo página…</span>
        </div>
        <p id="panel-offline-notice" role="status" aria-live="polite"
            class="fixed inset-x-4 bottom-24 z-50 mx-auto hidden max-w-sm rounded-xl border border-amber-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-800 shadow-lg lg:bottom-6">
            Esta sección necesita conexión. Sigues en la misma pantalla.
        </p>
        <div class="lg:flex lg:min-h-screen">
            <!-- Sidebar escritorio -->
            <aside
                class="hidden w-64 shrink-0 flex-col border-r border-slate-200 bg-white lg:flex"
            >
                <a href="/panel" class="flex h-20 items-center gap-3 border-b border-slate-100 px-5">
                    <img
                        src="/brand-logo.png"
                        alt="JyM Mantenimientos"
                        class="h-14 w-32 object-contain"
                    />
                    <div>
                        <p class="text-xs font-medium text-slate-500">Panel de operaciones</p>
                    </div>
                </a>

                <nav class="flex-1 space-y-1 p-3">
                    {
                        items.map((item) => {
                            const Icon = item.icon;
                            const active = isActive(item.href, item.exact);
                            return (
                                <a
                                    href={item.href}
                                    aria-current={active ? 'page' : undefined}
                                    class:list={[
                                        'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition',
                                        active
                                            ? 'bg-sky-50 text-sky-800'
                                            : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
                                    ]}
                                >
                                    <Icon className="h-5 w-5" />
                                    {item.label}
                                </a>
                            );
                        })
                    }
                </nav>

                <div class="border-t border-slate-100 p-3">
                    <div class="mb-2 flex items-center gap-3 rounded-xl px-3 py-2">
                        <div
                            class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-100 text-sm font-bold text-sky-800"
                        >
                            {initial}
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-xs font-semibold text-slate-700">
                                {userEmail || 'Sesión'}
                            </p>
                            <p class="text-[11px] text-slate-400">Administrador</p>
                        </div>
                    </div>
                    <form method="POST" action="/api/auth/signout">
                        <button
                            type="submit"
                            class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold text-slate-500 transition hover:bg-red-50 hover:text-red-700"
                        >
                            <LogOut className="h-4 w-4" />
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </aside>

            <div class="flex min-h-screen flex-1 flex-col">
                <!-- Barra superior móvil -->
                <header
                    class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 backdrop-blur lg:hidden"
                >
                    <a href="/panel" class="flex items-center gap-2">
                        <img
                            src="/brand-icon-64.png"
                            alt="JyM Mantenimientos"
                            class="h-9 w-9 object-contain"
                        />
                        <span class="text-sm font-extrabold tracking-tight">JyM</span>
                    </a>
                    <form method="POST" action="/api/auth/signout">
                        <button
                            type="submit"
                            aria-label="Cerrar sesión"
                            class="flex h-12 w-12 items-center justify-center rounded-xl text-slate-500 transition hover:bg-slate-100"
                        >
                            <LogOut className="h-5 w-5" />
                        </button>
                    </form>
                </header>

                <main data-user-id={Astro.locals.user?.id ?? ''} class="min-w-0 flex-1 px-5 pb-28 pt-5 sm:px-6 lg:px-10 lg:py-8 lg:pb-10">
                    <p id="panel-connection-status" role="status"
                        class="mb-4 hidden rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm font-semibold text-amber-900">
                        Sin conexión. Hoy y Ruta pueden mostrar la última copia guardada; abre cada visita para ver sus cambios locales.
                    </p>
                    <AutomaticVisitStatus client:load userId={Astro.locals.user?.id ?? ''} />
                    <slot />
                </main>

                <!-- Navegación inferior móvil -->
                <nav
                    class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white/95 backdrop-blur lg:hidden"
                    style="padding-bottom: env(safe-area-inset-bottom)"
                >
                    <div class="grid grid-cols-6">
                        {
                            mobileItems.map((item) => {
                                const Icon = item.icon;
                                const active = isActive(item.href, item.exact);
                                return (
                                    <a
                                        href={item.href}
                                        aria-current={active ? 'page' : undefined}
                                        class:list={[
                                         'flex min-h-14 flex-col items-center justify-center gap-1 py-1 text-[11px] font-semibold transition',
                                            active ? 'text-sky-700' : 'text-slate-500',
                                        ]}
                                    >
                                        <Icon className="h-5 w-5" />
                                        {item.label}
                                    </a>
                                );
                            })
                        }
                    </div>
                </nav>
            </div>
        </div>
        <VoiceConversation client:load />
        <script>
            import { clearOfflineData, listEncrypted } from '@/lib/offline-storage';
            import { clearAutomaticVisits, listLocal } from '@/lib/automatic-visits';
            import { getToday } from '@/lib/dates';
            import { hasOfflinePage, isOfflinePage } from '@/lib/offline-navigation';
            const userId = document.querySelector('main')?.getAttribute('data-user-id');
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    void navigator.serviceWorker.register('/sw.js', { scope: '/panel' })
                        .catch((error) => console.warn('No se pudo activar la PWA:', error));
                });
            }
            document.querySelectorAll<HTMLFormElement>('form[action="/api/auth/signout"]').forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    try {
                        const entries = await listEncrypted();
                        const automatic = userId ? await listLocal(userId) : [];
                        if ((entries.some((entry) => entry.pending) || automatic.some((entry) => entry.pending)) &&
                            !window.confirm('Hay visitas sin sincronizar. Cerrar sesión borrará definitivamente el trabajo local. ¿Continuar?')) return;
                        await clearOfflineData();
                        await clearAutomaticVisits();
                        const registration = await navigator.serviceWorker?.getRegistration();
                        registration?.active?.postMessage({ type: 'clear-private' });
                        await caches.delete('jym-panel-pages-v3');
                        form.submit();
                    } catch {
                        window.alert('No se pudieron borrar los datos offline. Cierra otras pestañas del panel e inténtalo de nuevo.');
                    }
                });
            });
            const navigation = document.querySelector<HTMLElement>('#panel-navigation-status')!;
            const message = navigation.querySelector<HTMLElement>('[data-message]')!;
            const connection = document.querySelector<HTMLElement>('#panel-connection-status')!;
            const offlineNotice = document.querySelector<HTMLElement>('#panel-offline-notice')!;
            let slowTimer: number | undefined;
            let noticeTimer: number | undefined;
            let navigationAttempt = 0;
            let pendingPath = '';
            const showOfflineNotice = () => {
                offlineNotice.classList.remove('hidden');
                window.clearTimeout(noticeTimer);
                noticeTimer = window.setTimeout(() => offlineNotice.classList.add('hidden'), 5_000);
            };
            const showLoading = (text: string) => {
                message.textContent = text;
                navigation.classList.remove('hidden');
                window.clearTimeout(slowTimer);
                slowTimer = window.setTimeout(() => {
                    message.textContent = 'Conexión lenta. Espera; no pulses de nuevo.';
                }, 8_000);
            };
            const resetLoading = () => {
                window.clearTimeout(slowTimer);
                pendingPath = '';
                navigation.classList.add('hidden');
                document.querySelectorAll<HTMLButtonElement>('form[data-submitting] button[type="submit"]')
                    .forEach((button) => { button.disabled = false; });
                document.querySelectorAll('form[data-submitting]').forEach((form) => {
                    delete (form as HTMLElement).dataset.submitting;
                });
            };
            const connectionChanged = () => { connection.classList.toggle('hidden', navigator.onLine); };
            connectionChanged();
            window.addEventListener('online', connectionChanged);
            window.addEventListener('offline', connectionChanged);
            window.addEventListener('pageshow', resetLoading);
            window.addEventListener('pagehide', resetLoading);
            const canReachSite = async () => {
                try {
                    // HEAD no lo intercepta el service worker: prueba la red real,
                    // incluso si navigator.onLine sigue diciendo «conectado».
                    const response = await fetch('/sw.js', {
                        method: 'HEAD', cache: 'no-store', signal: AbortSignal.timeout(4_000),
                    });
                    return response.ok && response.headers.get('content-type')?.includes('javascript') === true;
                } catch { return false; }
            };
            document.addEventListener('click', (event) => {
                if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey ||
                    event.shiftKey || event.altKey) return;
                const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
                if (!link || link.target || link.hasAttribute('download') ||
                    link.origin !== window.location.origin ||
                    (link.pathname === window.location.pathname && link.search === window.location.search &&
                        link.hash)) return;
                const attempt = ++navigationAttempt;
                if (pendingPath === link.href) { event.preventDefault(); return; }
                if (link.pathname === '/panel' || link.pathname.startsWith('/panel/')) {
                    event.preventDefault();
                    void (async () => {
                        let saved = false;
                        if (isOfflinePage(link.pathname)) {
                            try {
                                saved = await hasOfflinePage(link.pathname, link.search, getToday(),
                                    (path) => caches.match(path));
                            } catch { /* Si falla la caché, comprobar la conexión. */ }
                        }
                        const available = saved || (navigator.onLine && await canReachSite());
                        if (attempt !== navigationAttempt) return;
                        if (!available) {
                            resetLoading();
                            showOfflineNotice();
                            return;
                        }
                        offlineNotice.classList.add('hidden');
                        pendingPath = link.href;
                        showLoading(link.pathname === '/panel' ? 'Abriendo Hoy…' : 'Abriendo página…');
                        window.location.assign(link.href);
                    })();
                    return;
                }
                pendingPath = link.href;
                if (link.pathname.startsWith('/panel/')) showLoading('Abriendo página…');
                else if (link.pathname === '/panel') showLoading('Abriendo Hoy…');
            });
            document.addEventListener('submit', (event) => {
                if (event.defaultPrevented) return;
                const form = event.target as HTMLFormElement;
                if (form.action.endsWith('/api/auth/signout')) return;
                if (form.dataset.submitting) { event.preventDefault(); return; }
                if (form.method.toLowerCase() === 'post' && !navigator.onLine) {
                    event.preventDefault();
                    window.alert('Esta acción necesita conexión. Las visitas se guardan desde su propia pantalla.');
                    return;
                }
                form.dataset.submitting = 'true';
                showLoading(form.method.toLowerCase() === 'post' ? 'Enviando cambios…' : 'Abriendo página…');
                // Desactivar después de que el navegador construya el FormData, sin perder
                // el botón pulsado (move/end en Ruta) ni sus valores.
                window.setTimeout(() => {
                    form.querySelectorAll<HTMLButtonElement>('button[type="submit"]')
                        .forEach((button) => { button.disabled = true; });
                }, 0);
            });
        </script>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: "Inter", system-ui, -apple-system, sans-serif;
    }
    body {
        font-family: var(--font-sans);
    }
</style>
