---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import EmptyState from '@/components/panel/EmptyState.astro';
import { listClientsWithPropertyCount } from '@/server/clients';

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const clients = await listClientsWithPropertyCount(q);
---

<PanelLayout title="Clientes">
    <PageHeader
        title="Clientes"
        description="Cada cliente puede tener una o varias propiedades con piscina."
    >
        <a
            href="/panel/clientes/nuevo"
            class="inline-flex h-10 items-center justify-center rounded-xl bg-sky-700 px-4 text-sm font-bold text-white transition hover:bg-sky-800"
        >
            + Nuevo cliente
        </a>
    </PageHeader>

    <form method="GET" class="mb-5 flex gap-2">
        <input
            name="q"
            value={q}
            type="search"
            placeholder="Buscar por nombre, teléfono o correo"
            class="h-11 min-w-0 flex-1 rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:ring-4 focus:ring-sky-100"
        />
        <button
            type="submit"
            class="inline-flex h-11 shrink-0 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
            Buscar
        </button>
    </form>

    {
        clients.length === 0 ? (
            <EmptyState
                title={q ? 'Sin resultados' : 'Todavía no hay clientes'}
                description={
                    q
                        ? 'Prueba con otro nombre, teléfono o correo.'
                        : 'Crea tu primer cliente y luego agrega la propiedad donde está la piscina.'
                }
            >
                {q ? (
                    <a
                        href="/panel/clientes"
                        class="inline-flex h-10 items-center justify-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700"
                    >
                        Limpiar búsqueda
                    </a>
                ) : (
                    <a
                        href="/panel/clientes/nuevo"
                        class="inline-flex h-10 items-center justify-center rounded-xl bg-sky-700 px-4 text-sm font-bold text-white"
                    >
                        + Nuevo cliente
                    </a>
                )}
            </EmptyState>
        ) : (
            <ul class="grid grid-cols-1 gap-3">
                {clients.map((client) => (
                    <li class="min-w-0">
                        <a
                            href={`/panel/clientes/${client.id}`}
                            class="flex w-full min-w-0 items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-sky-300 hover:shadow-md"
                        >
                            <div class="min-w-0 flex-1">
                                <div class="flex min-w-0 flex-wrap items-center gap-2">
                                    <p class="min-w-0 max-w-full truncate text-base font-extrabold text-slate-900">
                                        {client.name}
                                    </p>
                                    <span
                                        class:list={[
                                            'shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-bold',
                                            client.status === 'active'
                                                ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                                                : 'border-slate-200 bg-slate-50 text-slate-500',
                                        ]}
                                    >
                                        {client.status === 'active' ? 'Activo' : 'Inactivo'}
                                    </span>
                                </div>
                                <p class="mt-1 truncate text-sm text-slate-500">
                                    {[client.phone, client.email].filter(Boolean).join(' · ') ||
                                        'Sin datos de contacto'}
                                </p>
                            </div>
                            <div class="shrink-0 text-right">
                                <p class="text-lg font-extrabold text-slate-900">
                                    {client.propertyCount}
                                </p>
                                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">
                                    {client.propertyCount === 1 ? 'propiedad' : 'propiedades'}
                                </p>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</PanelLayout>
