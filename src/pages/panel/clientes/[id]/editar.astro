---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import ClientForm from '@/components/panel/ClientForm';
import { getClient } from '@/server/clients';

const id = Astro.params.id;
if (!id) return Astro.redirect('/panel/clientes');

const client = await getClient(id);
if (!client) return Astro.redirect('/panel/clientes');
---

<PanelLayout title={`Editar ${client.name}`}>
    <PageHeader title="Editar cliente" description={client.name} />

    <div class="max-w-3xl">
        <ClientForm
            client:load
            mode="edit"
            client={{
                id: client.id,
                name: client.name,
                phone: client.phone,
                email: client.email,
                notes: client.notes,
                status: client.status,
            }}
        />
    </div>
</PanelLayout>
