---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import SettingsForm from '@/components/panel/SettingsForm';
import PushSettings from '@/components/panel/PushSettings';
import InstallApp from '@/components/panel/InstallApp';
import { getSettings } from '@/server/settings';
import { getNotificationUserId } from '@/server/push-reminders';
import { PUBLIC_VAPID_PUBLIC_KEY } from 'astro:env/client';
import { db, profiles } from '@/db';

const settings = await getSettings();
const joseUserId = await getNotificationUserId();
const users = Astro.locals.profile?.role === 'owner'
    ? await db.select({ id: profiles.id, name: profiles.fullName }).from(profiles)
    : [];
const userEmail = Astro.locals.user?.email ?? '';

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---

<PanelLayout title="Ajustes">
    <PageHeader
        title="Ajustes"
        description="Datos de la empresa, base de rutas y seguridad de la cuenta."
    />

    <div class="grid gap-4 lg:grid-cols-3">
        <section class="lg:col-span-2">
            <SettingsForm client:load initial={settings} />
        </section>

        <div class="space-y-4">
            <InstallApp client:load />
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-base font-extrabold text-slate-900">Cuenta</h2>
                <p class="mt-1 text-xs font-bold uppercase tracking-wide text-slate-400">
                    Correo
                </p>
                <p class="mt-0.5 break-all text-sm font-medium text-slate-800">
                    {userEmail}
                </p>

                <div class="mt-4 border-t border-slate-100 pt-4">
                    <h3 class="text-sm font-extrabold text-slate-900">Cambiar contraseña</h3>

                    {
                        ok === 'password' && (
                            <p class="mt-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800">
                                Contraseña actualizada.
                            </p>
                        )
                    }
                    {
                        error === 'password' && (
                            <p class="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">
                                No se pudo cambiar. Usa al menos 8 caracteres.
                            </p>
                        )
                    }

                    <form method="POST" action="/api/panel/password" class="mt-3 space-y-3">
                        <label for="password" class="sr-only">Nueva contraseña</label>
                        <input
                            id="password"
                            name="password"
                            type="password"
                            minlength="8"
                            required
                            autocomplete="new-password"
                            placeholder="Nueva contraseña (mín. 8)"
                            class="h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-4 focus:ring-sky-100"
                        />
                        <button
                            type="submit"
                            class="inline-flex h-10 w-full items-center justify-center rounded-xl border border-slate-300 bg-white text-sm font-bold text-slate-700 transition hover:bg-slate-50"
                        >
                            Actualizar contraseña
                        </button>
                    </form>
                </div>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-sm font-extrabold text-slate-900">Recordatorios</h2>
                <p class="mt-1 text-xs text-slate-500">
                    Los avisos de llave y bomba se envían solo a la cuenta designada de José.
                    No se incluyen mediciones ni avisos de cloro.
                </p>
                {Astro.locals.profile?.role === 'owner' && (
                    <form action="/api/panel/notifications/recipient" method="POST" class="mt-3 space-y-2">
                        <label for="jose-user" class="block text-xs font-bold text-slate-700">Cuenta de José</label>
                        <select id="jose-user" name="userId" class="h-11 w-full rounded-xl border border-slate-300 px-3">
                            <option value="">Sin asignar</option>
                            {users.map((user) => <option value={user.id} selected={user.id === joseUserId}>{user.name}</option>)}
                        </select>
                        <button type="submit" class="panel-btn panel-btn-secondary">Guardar destinatario</button>
                        {ok === 'recipient' && <p role="status" class="text-sm text-emerald-700">Destinatario actualizado.</p>}
                    </form>
                )}
            </section>
            {Astro.locals.user?.id === joseUserId && <PushSettings client:load publicKey={PUBLIC_VAPID_PUBLIC_KEY ?? ''} />}
        </div>
    </div>
</PanelLayout>
