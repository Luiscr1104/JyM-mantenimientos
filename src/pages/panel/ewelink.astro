---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import { ewelinkConfigured, ewelinkConnected, listEwelinkDevices, readEwelinkDeviceStatus } from '@/server/ewelink';

if (Astro.locals.profile?.role !== 'owner') return Astro.redirect('/panel');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const configured = ewelinkConfigured();
const connected = configured && await ewelinkConnected();
let inventory: Awaited<ReturnType<typeof listEwelinkDevices>> | null = null;
let error = '';
if (connected) {
    try {
        inventory = await listEwelinkDevices();
    } catch (reason) {
        error = reason instanceof Error ? reason.message : 'No se pudo consultar eWeLink.';
    }
}
const requestedId = Astro.url.searchParams.get('device');
const selected = inventory?.devices.find((device) => device.id === requestedId);
let status: Awaited<ReturnType<typeof readEwelinkDeviceStatus>> | null = null;
if (selected) {
    try {
        status = await readEwelinkDeviceStatus(selected.id);
    } catch (reason) {
        error = reason instanceof Error ? reason.message : 'No se pudo consultar el estado.';
    }
}
const messages: Record<string, string> = {
    config: 'Faltan EWELINK_APP_ID y EWELINK_APP_SECRET en el servidor.',
    domain: 'Abre esta página desde jymmantenimientos.com para autorizar la cuenta.',
    session: 'La sesión del panel caducó. Entra de nuevo y vuelve a conectar.',
    authorization: 'La autorización no coincidió o caducó. Reintenta desde aquí.',
    exchange: 'eWeLink no completó la autorización. Revisa la configuración de la app y reintenta.',
};
const notice = messages[Astro.url.searchParams.get('error') ?? ''];
---

<PanelLayout title="eWeLink · diagnóstico">
    <PageHeader title="eWeLink · diagnóstico" description="Solo lectura: inventario y consumo disponible, sin controlar interruptores." />
    <div class="space-y-4">
        <a href="/panel/ajustes" class="text-sm font-semibold text-sky-800 underline">← Volver a ajustes</a>
        {Astro.url.searchParams.get('ok') === 'connected' && <p role="status" class="rounded-lg bg-emerald-50 p-3 text-sm text-emerald-800">Cuenta vinculada. Esta página no enciende ni apaga equipos.</p>}
        {(notice || error) && <p role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-800">{notice || error}</p>}
        {!configured ? <p>Configura las credenciales de eWeLink solo en el servidor.</p> : (
            <section class="rounded-xl border border-slate-200 bg-white p-5">
                <p class="text-sm text-slate-700">{connected ? 'Cuenta eWeLink vinculada.' : 'Cuenta eWeLink aún no vinculada.'}</p>
                <form method="POST" action="/api/panel/ewelink/connect" class="mt-3">
                    <button type="submit" class="panel-btn panel-btn-secondary">{connected ? 'Volver a autorizar cuenta' : 'Autorizar cuenta eWeLink'}</button>
                </form>
                <p class="mt-2 text-xs text-slate-500">Usa el dominio jymmantenimientos.com. No se almacena la contraseña eWeLink.</p>
            </section>
        )}
        {inventory && (
            <section class="rounded-xl border border-slate-200 bg-white p-5">
                <h2 class="font-bold text-slate-900">Dispositivos de la vivienda actual</h2>
                <p class="mt-1 text-xs text-slate-600">eWeLink informa {inventory.total} elementos; se consultan hasta 30 por solicitud. El estado puede ser una copia y no confirma el estado físico.</p>
                {inventory.devices.length === 0 ? <p class="mt-3 text-sm">La API no devolvió dispositivos autorizados en esta vivienda.</p> : (
                    <ul class="mt-3 space-y-3">
                        {inventory.devices.map((device) => (
                            <li class="rounded-lg border border-slate-200 p-3 text-sm">
                                <p class="font-semibold">{device.name} · {device.model ?? 'Modelo no indicado'}</p>
                                <p class="text-xs text-slate-600">Marca: {device.brand ?? 'No indicada'} · UIID: {device.uiid ?? 'No indicado'} · {device.online ? 'En línea' : 'Sin conexión'}</p>
                                <p class="text-xs text-slate-600">Parámetros disponibles en la lista: {Object.keys(device.telemetry).join(', ') || 'ninguno'}</p>
                                <a class="text-sky-800 underline" href={`/panel/ewelink?device=${encodeURIComponent(device.id)}`}>Consultar estado y consumo disponible →</a>
                            </li>
                        ))}
                    </ul>
                )}
            </section>
        )}
        {selected && status && (
            <section class="rounded-xl border border-slate-200 bg-white p-5">
                <h2 class="font-bold">Datos entregados por la API: {selected.name}</h2>
                <p class="mt-1 text-xs text-slate-600">Valores sin convertir: las unidades dependen del UIID. No se deduce consumo si la API no lo informa.</p>
                {Object.entries(status).length ? (
                    <dl class="mt-3 grid gap-2 sm:grid-cols-2">
                        {Object.entries(status).map(([key, value]) => (
                            <div class="rounded-lg bg-slate-50 p-2"><dt class="text-xs font-semibold">{key}</dt><dd class="break-all text-sm">{String(value)}</dd></div>
                        ))}
                    </dl>
                ) : <p class="mt-3 text-sm">No se recibieron campos de consumo o estado reconocidos.</p>}
            </section>
        )}
    </div>
</PanelLayout>
