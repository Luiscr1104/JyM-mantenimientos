---
import { z } from 'zod';
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import VisitWorkspace from '@/components/panel/VisitWorkspace';
import { formatLongDate } from '@/lib/dates';
import { visitStatusLabel, visitStatusStyle } from '@/lib/format';
import { googleMapsStopUrl } from '@/lib/geo';
import { getVisitWithProperty } from '@/server/visits';
import { listVisitProducts } from '@/server/visit-products';
import { getOpenWaterTaskForProperty } from '@/server/water-fill';
import type { ProductKey } from '@/lib/products';

const id = z.uuid().safeParse(Astro.params.id);
if (!id.success) return Astro.redirect('/panel/agenda');
const data = await getVisitWithProperty(id.data);
if (!data) return Astro.redirect('/panel/agenda');

const { visit, property, client } = data;
const [products, waterTask] = await Promise.all([
    listVisitProducts(visit.id),
    getOpenWaterTaskForProperty(property.id),
]);
const location = property.lat != null && property.lng != null
    ? googleMapsStopUrl({ lat: property.lat, lng: property.lng })
    : null;
---

<PanelLayout title={`Visita · ${property.alias}`}>
    <PageHeader title={property.alias} description={`${client.name} · ${formatLongDate(visit.scheduledFor)}`}>
        <a href={`/panel/ruta?date=${visit.scheduledFor}`}
            class="inline-flex h-11 items-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-bold text-slate-700">
            ← Volver a la ruta
        </a>
    </PageHeader>

    <div class="mx-auto max-w-3xl space-y-5">
        {Astro.url.searchParams.get('error') && (
            <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800">
                {Astro.url.searchParams.get('error')}
            </div>
        )}
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-lg font-extrabold text-slate-900">Llegada y acceso</h2>
                <span class:list={[
                    'rounded-full border px-3 py-1 text-xs font-bold',
                    visitStatusStyle(visit.status),
                ]}>{visitStatusLabel(visit.status)}</span>
            </div>
            <p class="mt-3 text-sm text-slate-700">{property.address}</p>
            {property.gateCode && <p class="mt-3 rounded-xl bg-slate-100 p-3 text-sm font-semibold text-slate-800">
                Portón: {property.gateCode}
            </p>}
            {property.accessNotes && <p class="mt-3 whitespace-pre-line text-sm text-slate-700">{property.accessNotes}</p>}
            {property.pumpNotes && <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                <strong>Equipos:</strong> {property.pumpNotes}
            </p>}
            {location && <a href={location} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-flex h-11 w-full items-center justify-center rounded-xl bg-sky-700 px-4 text-sm font-bold text-white sm:w-auto">
                Navegar a la propiedad
            </a>}
        </section>

        <VisitWorkspace client:load
            id={visit.id}
            date={visit.scheduledFor}
            propertyId={property.id}
            propertyName={property.alias}
            initialProducts={products.map(({ id, product, quantity }) => ({
                id, product: product as ProductKey, quantity,
            }))}
            initialWaterTasks={waterTask ? [{
                id: waterTask.id,
                propertyId: property.id,
                propertyName: property.alias,
                visitId: waterTask.visitId,
                createdAt: waterTask.createdAt.toISOString(),
                dueAt: waterTask.dueAt.toISOString(),
                delayMinutes: waterTask.delayMinutes,
            }] : []}
            initial={{
                status: visit.status,
                checklist: visit.checklist,
                notes: visit.notes,
                pendingReason: visit.pendingReason,
                pumpStartedAt: visit.pumpStartedAt?.toISOString() ?? null,
                pumpStoppedAt: visit.pumpStoppedAt?.toISOString() ?? null,
            }}
        />
    </div>
</PanelLayout>
