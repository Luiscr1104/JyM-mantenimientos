---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import EmptyState from '@/components/panel/EmptyState.astro';
import { listLeads, type LeadStatus } from '@/server/leads';
import { formatDateTime, leadStatusLabel, leadStatusStyle } from '@/lib/format';

const STATUSES: Array<{ value: LeadStatus | 'all'; label: string }> = [
    { value: 'all', label: 'Todos' },
    { value: 'new', label: 'Nuevos' },
    { value: 'contacted', label: 'Contactados' },
    { value: 'quoted', label: 'Cotizados' },
    { value: 'won', label: 'Ganados' },
    { value: 'lost', label: 'Perdidos' },
];

const statusParam = Astro.url.searchParams.get('status');
const current = STATUSES.find((item) => item.value === statusParam)?.value ?? 'all';
const status = current === 'all' ? undefined : current;

const leads = await listLeads(200, status);
---

<PanelLayout title="Leads">
    <PageHeader
        title="Leads"
        description="Mensajes que llegan desde el formulario del sitio web."
    />

    <div class="mb-5 flex flex-wrap gap-2">
        {
            STATUSES.map((item) => (
                <a
                    href={item.value === 'all' ? '/panel/leads' : `/panel/leads?status=${item.value}`}
                    class:list={[
                        'rounded-full border px-3 py-1.5 text-xs font-bold transition',
                        current === item.value
                            ? 'border-sky-700 bg-sky-700 text-white'
                            : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300',
                    ]}
                >
                    {item.label}
                </a>
            ))
        }
    </div>

    {
        leads.length === 0 ? (
            <EmptyState
                title="No hay leads en esta vista"
                description="Cuando alguien envíe el formulario de contacto, aparecerá aquí."
            />
        ) : (
            <ul class="grid gap-3">
                {leads.map((lead) => (
                    <li class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-base font-extrabold text-slate-900">{lead.name}</p>
                                    <span
                                        class:list={[
                                            'rounded-full border px-2 py-0.5 text-[11px] font-bold',
                                            leadStatusStyle(lead.status),
                                        ]}
                                    >
                                        {leadStatusLabel(lead.status)}
                                    </span>
                                </div>
                                <p class="mt-1 text-xs text-slate-400">
                                    {formatDateTime(lead.createdAt)}
                                </p>
                            </div>

                            <form
                                method="POST"
                                action={`/api/panel/leads/${lead.id}`}
                                class="flex items-center gap-2"
                            >
                                <label for={`status-${lead.id}`} class="sr-only">
                                    Cambiar estado
                                </label>
                                <select
                                    id={`status-${lead.id}`}
                                    name="status"
                                    class="h-9 rounded-lg border border-slate-300 bg-white px-2 text-xs font-semibold text-slate-700"
                                >
                                    {STATUSES.filter((item) => item.value !== 'all').map((item) => (
                                        <option value={item.value} selected={item.value === lead.status}>
                                            {item.label}
                                        </option>
                                    ))}
                                </select>
                                <button
                                    type="submit"
                                    class="h-9 rounded-lg border border-slate-300 bg-white px-3 text-xs font-bold text-slate-700 transition hover:bg-slate-50"
                                >
                                    Actualizar
                                </button>
                            </form>
                        </div>

                        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                            <a
                                href={`https://wa.me/${lead.phone.replace(/\D/g, '')}?text=${encodeURIComponent(
                                    `Hola ${lead.name}, le escribo de JyM Mantenimientos por su consulta.`,
                                )}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold text-sky-700 hover:underline"
                            >
                                {lead.phone} · WhatsApp
                            </a>
                            {lead.email && (
                                <a href={`mailto:${lead.email}`} class="text-slate-600 hover:underline">
                                    {lead.email}
                                </a>
                            )}
                        </div>

                        <p class="mt-3 whitespace-pre-line rounded-xl bg-slate-50 p-3 text-sm text-slate-700">
                            {lead.message}
                        </p>
                    </li>
                ))}
            </ul>
        )
    }
</PanelLayout>
