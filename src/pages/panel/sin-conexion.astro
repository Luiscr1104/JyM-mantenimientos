---
import '@/styles/global.css';
import OfflineVisits from '@/components/panel/OfflineVisits';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#0369a1" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <title>Visitas sin conexión | JyM</title>
    </head>
    <body class="min-h-screen bg-slate-50 p-4 text-slate-900 sm:p-8">
        <main class="mx-auto max-w-2xl space-y-4">
            <header class="flex items-center gap-3">
                <img src="/brand-icon-64.png" width="48" height="48" alt="" />
                <div>
                    <h1 class="text-xl font-extrabold">Visitas sin conexión</h1>
                    <p class="text-sm text-slate-600">Los cierres locales no se confirman hasta sincronizar.</p>
                </div>
            </header>
            <OfflineVisits client:load />
            <a href="/panel" class="block py-3 font-semibold text-sky-800 underline">Volver al panel</a>
        </main>
    </body>
</html>
