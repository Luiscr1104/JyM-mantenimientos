---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import DateNav from '@/components/panel/DateNav.astro';
import RouteMap from '@/components/panel/RouteMap';
import { getToday, isValidDate } from '@/lib/dates';
import { workTypesLabel } from '@/lib/visit-types';
import { formatDistance, formatDuration, formatTime, formatVisitDuration, visitStatusLabel, visitStatusStyle } from '@/lib/format';
import { decodePolyline, googleMapsRouteUrl } from '@/lib/geo';
import { orderPendingVisits } from '@/lib/route-order';
import { getRoutePlan } from '@/server/routes';
import { getSettings } from '@/server/settings';
import { listVisitsByDate } from '@/server/visits';

const dateParam = Astro.url.searchParams.get('date');
const date = isValidDate(dateParam) ? dateParam : getToday();

const [plan, dayVisits, settings] = await Promise.all([
    getRoutePlan(date),
    listVisitsByDate(date),
    getSettings(),
]);

const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
const hasBase = settings.baseLat != null && settings.baseLng != null;

const pendingVisits = dayVisits.filter((row) => row.visit.status === 'scheduled');
const currentVisits = dayVisits.filter((row) => row.visit.status === 'in_progress');
const isToday = date === getToday();
const completedVisits = dayVisits.filter((row) => row.visit.status === 'completed');
const startFromCurrentLocation = isToday && (!!plan || currentVisits.length > 0 || completedVisits.length > 0 || !hasBase);
const byVisitId = new Map(pendingVisits.map((row) => [row.visit.id, row]));
const planVisitIds = new Set((plan?.stops ?? []).map((stop) => stop.visitId));

const remaining = pendingVisits.filter((row) => !planVisitIds.has(row.visit.id));
const ordered = orderPendingVisits(pendingVisits, plan?.stops);
const manuallyOrdered = plan?.source === 'manual';
const routeIsCurrent = !manuallyOrdered && !!plan?.origin &&
    plan.stops.every((stop) => byVisitId.has(stop.visitId)) &&
    remaining.every((row) =>
        row.property.lat == null || row.property.lng == null
            ? row.visit.createdAt <= plan.optimizedAt
            : false,
    );

const mapStops = ordered
    .filter((row) => row.property.lat != null && row.property.lng != null)
    .map((row, index) => ({
        order: index + 1,
        lat: row.property.lat as number,
        lng: row.property.lng as number,
        label: row.property.alias,
    }));

const base =
    hasBase && settings.baseLat != null && settings.baseLng != null
        ? { lat: settings.baseLat, lng: settings.baseLng }
        : null;
const origin = plan?.origin ?? base;
const polyline = routeIsCurrent && plan?.polyline && plan.origin
    ? decodePolyline(plan.polyline)
    : origin
      ? [[origin.lat, origin.lng], ...mapStops.map((stop) => [stop.lat, stop.lng])] as Array<[number, number]>
      : [];

const mapsUrl = origin && (routeIsCurrent || manuallyOrdered)
    ? googleMapsRouteUrl(
          origin,
          mapStops.map((stop) => ({ lat: stop.lat, lng: stop.lng })),
      )
    : null;
---

<PanelLayout title="Ruta">
    <PageHeader title="Ruta del día" description="Ordena las paradas, navega y realiza las visitas.">
        <a
            href={`/panel/agenda?date=${date}&from=route#gestionar-visitas`}
            class="panel-btn panel-btn-primary"
        >
            Agregar o quitar visitas
        </a>
    </PageHeader>

    <DateNav date={date} basePath="/panel/ruta" />

    {
        ok === 'route' && (
            <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
                Ruta optimizada correctamente.
            </div>
        )
    }
    {ok === 'order' && (
        <p role="status" class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
            Orden de paradas actualizado.
        </p>
    )}
    {ok === 'visit-added' && (
        <p role="status" class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
            Parada agregada. Recalcula la ruta si quieres optimizar el nuevo recorrido.
        </p>
    )}
    {ok === 'visit-exists' && (
        <p role="status" class="mb-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-semibold text-sky-800">
            Esa propiedad ya está en la agenda de este día.
        </p>
    )}
    {ok === 'visit-removed' && (
        <p role="status" class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
            Visita quitada del día.{pendingVisits.length > 0 && ' Optimiza la ruta si necesitas actualizar el recorrido.'}
        </p>
    )}
    {
        error && (
            <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                {error}
            </div>
        )
    }

    {
        dayVisits.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-5 text-center sm:p-10">
                <p class="text-3xl">🗺️</p>
                <h2 class="mt-2 text-lg font-extrabold text-slate-900">No hay paradas este día</h2>
                <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">
                    Agrega visitas en la agenda y vuelve para optimizar el recorrido.
                </p>
                <a
                    href={`/panel/agenda?date=${date}&from=route#gestionar-visitas`}
                    class="panel-btn panel-btn-primary mt-5"
                >
                    Agregar visita en Agenda
                </a>
            </div>
        ) : (
            <div class="space-y-4">
                {pendingVisits.length === 0 && currentVisits.length === 0 && (
                    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-sm font-semibold text-emerald-800">
                        Todas las visitas están completadas. No quedan paradas por recorrer.
                    </div>
                )}
                <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
                    <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0">
                            <p class="text-xs font-bold uppercase tracking-wide text-slate-400">
                                {manuallyOrdered ? 'Orden manual' : routeIsCurrent ? 'Ruta optimizada' : 'Sin optimizar'}
                            </p>
                            <p class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl">
                                {pendingVisits.length}{' '}
                                {pendingVisits.length === 1 ? 'parada pendiente' : 'paradas pendientes'}
                            </p>
                            {routeIsCurrent && plan && (
                                <p class="mt-1 text-sm font-semibold text-slate-500">
                                    {formatDistance(plan.distanceMeters)} · {formatDuration(plan.durationSeconds)}
                                </p>
                            )}
                            {routeIsCurrent && plan && (
                                <p class="mt-1 text-xs font-semibold text-slate-600">
                                    Desde {plan.origin?.label ?? 'la base'} · termina en la última visita, sin regreso a casa.
                                </p>
                            )}
                            {routeIsCurrent && plan?.source === 'fallback' && (
                                <p class="mt-1 text-xs font-semibold text-amber-700">
                                    Orden y distancia estimados por cercanía. La línea del mapa no sigue carreteras.
                                </p>
                            )}
                            {routeIsCurrent && plan && pendingVisits.length > plan.stops.length && (
                                <p class="mt-1 text-xs font-semibold text-amber-700">
                                    {pendingVisits.length - plan.stops.length} parada(s) sin ubicación no se incluyen
                                    en la distancia ni en la navegación completa.
                                </p>
                            )}
                            {manuallyOrdered && (
                                <p class="mt-1 text-xs font-semibold text-amber-700">
                                    El recorrido del mapa es aproximado. Recalcular la ruta volverá a ordenar las paradas por cercanía.
                                </p>
                            )}
                            {manuallyOrdered && pendingVisits.length > mapStops.length && (
                                <p class="mt-1 text-xs font-semibold text-amber-700">
                                    Las paradas sin ubicación no se incluyen en la navegación completa.
                                </p>
                            )}
                            {plan && !routeIsCurrent && !manuallyOrdered && pendingVisits.length > 0 && (
                                <p class="mt-1 text-xs font-semibold text-amber-700">
                                    Recalcula para actualizar el recorrido desde el punto de partida elegido.
                                </p>
                            )}
                        </div>

                        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:flex-wrap">
                            {pendingVisits.length > 0 && <form method="POST" action="/api/panel/route/optimize" class="route-optimize-form w-full sm:w-auto">
                                <input type="hidden" name="date" value={date} />
                                <input type="hidden" name="lat" />
                                <input type="hidden" name="lng" />
                                {isToday && <label class="block text-xs font-bold text-slate-700">
                                    Punto de partida
                                    <select name="start" class="mt-1 h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900">
                                        <option value="gps" selected={startFromCurrentLocation}>Mi ubicación actual (teléfono)</option>
                                        {currentVisits.filter((row) => row.property.lat != null && row.property.lng != null).map((row) => (
                                            <option value={`property:${row.visit.id}`}>Esta propiedad: {row.property.alias}</option>
                                        ))}
                                        <option value="base" selected={!startFromCurrentLocation}>Base (casa de José)</option>
                                    </select>
                                </label>}
                                {!isToday && <input type="hidden" name="start" value="base" />}
                                <button
                                    type="submit"
                                    class:list={['panel-btn mt-2 w-full sm:w-auto', plan ? 'panel-btn-secondary' : 'panel-btn-primary']}
                                >
                                    {plan ? 'Recalcular ruta' : 'Optimizar ruta'}
                                </button>
                                <p role="alert" class="route-location-error mt-1 hidden text-xs font-semibold text-red-700"></p>
                            </form>}

                            {mapsUrl && (
                                <a
                                    href={mapsUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="panel-btn panel-btn-secondary w-full sm:w-auto"
                                >
                                    Abrir en Google Maps
                                </a>
                            )}
                        </div>
                    </div>

                    {!hasBase && !isToday && (
                        <p class="mt-3 rounded-xl bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">
                            Configura la ubicación base en{' '}
                            <a href="/panel/ajustes" class="underline">
                                Ajustes
                            </a>{' '}
                            para optimizar.
                        </p>
                    )}
                </section>

                {currentVisits.length > 0 && (
                    <section class="rounded-2xl border border-sky-200 bg-sky-50 p-4">
                        <h2 class="font-extrabold text-sky-900">Visita en curso (no se repite en la ruta)</h2>
                        {currentVisits.map((row) => (
                            <a class="mt-2 block font-semibold text-sky-800 underline" href={`/panel/visitas/${row.visit.id}`}>
                                {row.property.alias} · Continuar visita
                            </a>
                        ))}
                    </section>
                )}
                {pendingVisits.length > 0 && <details class="route-map-panel min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <summary class="flex min-h-12 cursor-pointer items-center px-4 text-sm font-bold text-sky-800 lg:hidden">
                        Ver mapa de la ruta
                    </summary>
                    <div class="route-map-content min-w-0">
                        <RouteMap
                            client:only="react"
                            stops={mapStops}
                            base={origin}
                            polyline={polyline}
                            estimated={!routeIsCurrent || plan?.source === 'fallback'}
                        />
                    </div>
                </details>}

                {pendingVisits.length > 0 && <section>
                    <h2 class="mb-3 text-base font-extrabold text-slate-900">Orden de paradas</h2>
                    {ordered.length > 1 && (
                        <p class="mb-3 text-sm text-slate-600">Mueve una parada hacia abajo o déjala para el final del día.</p>
                    )}
                    <ol class="grid grid-cols-1 gap-2 sm:gap-3">
                        {ordered.map((row, index) => (
                            <li id={`visita-${row.visit.id}`} class="min-w-0 scroll-mt-4 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4">
                                <div class="flex min-w-0 items-start gap-2">
                                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky-700 text-sm font-extrabold text-white">
                                        {index + 1}
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <a
                                                href={`/panel/propiedades/${row.property.id}`}
                                                class="min-w-0 max-w-full truncate text-base font-extrabold text-slate-900 hover:underline"
                                            >
                                                {row.property.alias}
                                            </a>
                                            <span
                                                class:list={[
                                                    'shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-bold',
                                                    visitStatusStyle(row.visit.status),
                                                ]}
                                            >
                                                {visitStatusLabel(row.visit.status)}
                                            </span>
                                        </div>
                                        <p class="mt-0.5 truncate text-sm text-slate-500">
                                            {row.client.name} · {row.property.address}
                                        </p>
                                        <p class="mt-1 text-xs font-semibold text-sky-800">
                                            {workTypesLabel(row.visit.workTypes)}
                                        </p>
                                        {row.visit.startedAt && (
                                            <p class="mt-1 text-xs font-semibold text-slate-600">
                                                Llegada {formatTime(row.visit.startedAt)}
                                            </p>
                                        )}
                                    </div>
                                </div>
                                {index < ordered.length - 1 && (
                                    <form method="POST" action="/api/panel/route/reorder" class="mt-3 flex flex-wrap gap-2">
                                        <input type="hidden" name="date" value={date} />
                                        <input type="hidden" name="visitId" value={row.visit.id} />
                                        <button type="submit" name="move" value="down"
                                            aria-label={`Bajar ${row.property.alias} una posición`}
                                            class="panel-btn panel-btn-secondary min-h-11 px-3 text-sm">
                                            ↓ Bajar
                                        </button>
                                        {index < ordered.length - 2 && (
                                            <button type="submit" name="move" value="end"
                                                aria-label={`Enviar ${row.property.alias} al final`}
                                                class="panel-btn panel-btn-secondary min-h-11 px-3 text-sm">
                                                Enviar al final
                                            </button>
                                        )}
                                    </form>
                                )}
                                {row.property.gateCode && (
                                    <p class="mt-2 max-w-full break-words rounded-lg bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-600">
                                        Portón: {row.property.gateCode}
                                    </p>
                                )}
                                <div class="mt-2 grid grid-cols-2 gap-2">
                                    <a href={`/panel/visitas/${row.visit.id}`}
                                        class="panel-btn min-h-11 w-full bg-emerald-700 px-2 text-xs text-white hover:bg-emerald-800 sm:px-4 sm:text-sm">
                                        {row.visit.status === 'scheduled' ? 'Iniciar visita' : 'Continuar visita'}
                                    </a>
                                    {row.property.lat != null &&
                                    row.property.lng != null ? (
                                        <a
                                            href={`https://www.google.com/maps/dir/?api=1&destination=${row.property.lat},${row.property.lng}&travelmode=driving`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="panel-btn panel-btn-secondary min-h-11 w-full px-2 text-xs sm:px-4 sm:text-sm"
                                        >
                                            Navegar
                                        </a>
                                    ) : (
                                        <a
                                            href={`/panel/propiedades/${row.property.id}/editar`}
                                            class="panel-btn min-h-11 w-full border border-amber-300 bg-amber-50 px-2 text-xs text-amber-800 sm:px-4 sm:text-sm"
                                        >
                                            Falta ubicación
                                        </a>
                                    )}
                                </div>
                            </li>
                        ))}
                    </ol>
                </section>}
                {completedVisits.length > 0 && (
                    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                        <h2 class="text-base font-extrabold text-slate-900">
                            Visitas completadas ({completedVisits.length})
                        </h2>
                        <ul class="mt-3 space-y-2 text-sm text-slate-600">
                            {completedVisits.map((row) => (
                                <li>
                                    <a href={`/panel/visitas/${row.visit.id}`} class="font-semibold text-slate-800 hover:underline">
                                        {row.property.alias}
                                    </a>
                                    {' · '}{row.client.name}
                                    {(row.visit.startedAt || row.visit.leftAt || row.visit.completedAt) && (
                                        <span class="block text-xs">
                                            {row.visit.startedAt && `Llegada ${formatTime(row.visit.startedAt)}`}
                                            {(row.visit.leftAt ?? row.visit.completedAt) &&
                                                ` · Salida ${formatTime(row.visit.leftAt ?? row.visit.completedAt!)}`}
                                            {formatVisitDuration(row.visit.startedAt, row.visit.leftAt ?? row.visit.completedAt) &&
                                                ` · ${formatVisitDuration(row.visit.startedAt, row.visit.leftAt ?? row.visit.completedAt)} en propiedad`}
                                        </span>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </section>
                )}
            </div>
        )
    }
</PanelLayout>

<script>
    document.querySelectorAll<HTMLFormElement>('.route-optimize-form').forEach((form) => {
        const select = form.querySelector<HTMLSelectElement>('select[name="start"]');
        const latitude = form.querySelector<HTMLInputElement>('input[name="lat"]')!;
        const longitude = form.querySelector<HTMLInputElement>('input[name="lng"]')!;
        const message = form.querySelector<HTMLElement>('.route-location-error')!;
        select?.addEventListener('change', () => {
            latitude.value = '';
            longitude.value = '';
            message.classList.add('hidden');
        });
        form.addEventListener('submit', (event) => {
            if (!select) return;
            if (select.value !== 'gps' || (latitude.value && longitude.value)) return;
            event.preventDefault();
            if (!navigator.geolocation) {
                message.textContent = 'Este dispositivo no ofrece ubicación. Elige la propiedad actual o la base.';
                message.classList.remove('hidden');
                return;
            }
            message.textContent = 'Obteniendo ubicación…';
            message.classList.remove('hidden');
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    latitude.value = String(position.coords.latitude);
                    longitude.value = String(position.coords.longitude);
                    form.requestSubmit();
                },
                () => {
                    message.textContent = 'No se pudo obtener tu ubicación. Permite el acceso o elige la propiedad actual o la base.';
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 },
            );
        });
    });
</script>

<style is:global>
    @media (min-width: 1024px) {
        .route-map-panel:not([open]) > .route-map-content {
            display: block;
        }
    }
    @media (max-width: 1023px) {
        .route-map-panel .leaflet-container {
            height: 260px !important;
        }
    }
</style>
