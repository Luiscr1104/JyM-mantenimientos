---
import { z } from 'zod';
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import { formatDateTime } from '@/lib/format';
import { getPropertyWithClient } from '@/server/properties';
import { getEwelinkPilotForProperty, readEwelinkPilotForProperty } from '@/server/ewelink-pilot';

if (Astro.locals.profile?.role !== 'owner') return Astro.redirect('/panel');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const id = z.uuid().safeParse(Astro.params.id);
if (!id.success) return Astro.redirect('/panel/clientes');
const data = await getPropertyWithClient(id.data);
if (!data) return Astro.redirect('/panel/clientes');
const mapping = await getEwelinkPilotForProperty(data.property.id);
if (!mapping) return Astro.redirect(`/panel/propiedades/${data.property.id}`);
let reading: Awaited<ReturnType<typeof readEwelinkPilotForProperty>> = null;
let error = '';
try {
    // Solo se llama cuando el dueño abre esta página, nunca en segundo plano.
    reading = await readEwelinkPilotForProperty(data.property.id);
} catch (reason) {
    error = reason instanceof Error ? reason.message : 'No se pudo consultar eWeLink.';
}
---

<PanelLayout title={`Lecturas · ${data.property.alias}`}>
    <PageHeader title={`Lecturas · ${data.property.alias}`}
        description={`${data.client.name} · Sonoff ${mapping.name} · solo lectura`} />
    <div class="mx-auto max-w-3xl space-y-4">
        <a class="text-sm font-semibold text-sky-800 underline"
            href={`/panel/propiedades/${data.property.id}`}>← Volver a la propiedad</a>
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-slate-900">{mapping.name} · {mapping.model} · UIID {mapping.uiid}</h2>
            <p class="mt-2 text-sm text-slate-600">
                Lectura solicitada manualmente. Los valores son los que informa eWeLink, sin convertir
                unidades; no confirman el funcionamiento físico de la bomba.
            </p>
            <p class="mt-2 text-sm font-semibold text-amber-800">
                El Sonoff alimenta directamente el motor. El control seguirá deshabilitado hasta
                verificar capacidad, corriente de arranque y protecciones con un electricista.
            </p>
            {error && <p role="alert" class="mt-3 rounded-lg bg-red-50 p-3 text-sm text-red-800">{error}</p>}
            {reading && (
                <>
                    <p class="mt-3 text-xs text-slate-600">
                        Consulta realizada: {formatDateTime(reading.readAt)} · Puede reflejar el último estado reportado.
                    </p>
                    {Object.keys(reading.telemetry).length ? (
                        <dl class="mt-3 grid gap-2 sm:grid-cols-2">
                            {Object.entries(reading.telemetry).map(([key, value]) => (
                                <div class="rounded-lg bg-slate-50 p-3">
                                    <dt class="text-xs font-bold text-slate-600">{key}</dt>
                                    <dd class="break-all text-sm text-slate-900">{String(value)}</dd>
                                </div>
                            ))}
                        </dl>
                    ) : <p class="mt-3 text-sm">La API no entregó campos de estado o consumo reconocidos.</p>}
                </>
            )}
            <a href={`/panel/propiedades/${data.property.id}/energia`}
                class="panel-btn panel-btn-secondary mt-4">Consultar de nuevo</a>
        </section>
    </div>
</PanelLayout>
