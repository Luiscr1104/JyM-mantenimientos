---
import { z } from 'zod';
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import { formatDateTime } from '@/lib/format';
import { getPropertyWithClient } from '@/server/properties';
import { readEwelinkDeviceStatus } from '@/server/ewelink';
import { listEwelinkPropertyDevices } from '@/server/ewelink-links';

if (Astro.locals.profile?.role !== 'owner') return Astro.redirect('/panel');
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const id = z.uuid().safeParse(Astro.params.id);
if (!id.success) return Astro.redirect('/panel/clientes');
const data = await getPropertyWithClient(id.data);
if (!data) return Astro.redirect('/panel/clientes');
const linked = await listEwelinkPropertyDevices(data.property.id);
if (linked.length === 0) return Astro.redirect(`/panel/propiedades/${data.property.id}/equipos`);
const requested = Astro.url.searchParams.get('equipo');
const mapping = requested
    ? linked.find((device) => device.id === requested)
    : linked.length === 1 ? linked[0] : null;
let telemetry: Awaited<ReturnType<typeof readEwelinkDeviceStatus>> | null = null;
let readAt: Date | null = null;
let error = '';
if (requested && !mapping) error = 'Este equipo no está vinculado a la propiedad.';
if (mapping) {
    try {
        // Solo se llama cuando el dueño abre esta página, nunca en segundo plano.
        telemetry = await readEwelinkDeviceStatus(mapping.deviceId);
        readAt = new Date();
    } catch (reason) {
        error = reason instanceof Error ? reason.message : 'No se pudo consultar eWeLink.';
    }
}
---

<PanelLayout title={`Lecturas · ${data.property.alias}`}>
    <PageHeader title={`Lecturas · ${data.property.alias}`}
        description={`${data.client.name} · Sonoff · solo lectura`} />
    <div class="mx-auto max-w-3xl space-y-4">
        <a class="text-sm font-semibold text-sky-800 underline"
            href={`/panel/propiedades/${data.property.id}`}>← Volver a la propiedad</a>
        {linked.length > 1 && (
            <nav aria-label="Seleccionar equipo" class="flex flex-wrap gap-2">
                {linked.map((device) => (
                    <a class="panel-btn panel-btn-secondary"
                        href={`/panel/propiedades/${data.property.id}/energia?equipo=${device.id}`}>
                        {device.name}
                    </a>
                ))}
            </nav>
        )}
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-slate-900">
                {mapping ? `${mapping.name} · ${mapping.model ?? 'Modelo no indicado'} · UIID ${mapping.uiid ?? '—'}` : 'Selecciona un equipo'}
            </h2>
            <p class="mt-2 text-sm text-slate-600">
                Lectura solicitada manualmente. Los valores son los que informa eWeLink, sin convertir
                unidades; no confirman el funcionamiento físico de la bomba.
            </p>
            {data.property.alias === 'Casa Mariposa' && mapping?.name === 'Piscina bill' && (
                <p class="mt-2 text-sm font-semibold text-amber-800">
                    Este Sonoff alimenta directamente el motor. Antes de cualquier prueba de control,
                    un electricista debe verificar capacidad, corriente de arranque y protecciones.
                </p>
            )}
            <p class="mt-2 text-sm text-slate-600">No hay controles de encendido o apagado en esta PWA.</p>
            {error && <p role="alert" class="mt-3 rounded-lg bg-red-50 p-3 text-sm text-red-800">{error}</p>}
            {telemetry && readAt && (
                <>
                    <p class="mt-3 text-xs text-slate-600">
                        Consulta realizada: {formatDateTime(readAt)} · Puede reflejar el último estado reportado.
                    </p>
                    {Object.keys(telemetry).length ? (
                        <dl class="mt-3 grid gap-2 sm:grid-cols-2">
                            {Object.entries(telemetry).map(([key, value]) => (
                                <div class="rounded-lg bg-slate-50 p-3">
                                    <dt class="text-xs font-bold text-slate-600">{key}</dt>
                                    <dd class="break-all text-sm text-slate-900">{String(value)}</dd>
                                </div>
                            ))}
                        </dl>
                    ) : <p class="mt-3 text-sm">La API no entregó campos de estado o consumo reconocidos.</p>}
                </>
            )}
            {mapping && (
                <a href={`/panel/propiedades/${data.property.id}/energia?equipo=${mapping.id}`}
                    class="panel-btn panel-btn-secondary mt-4">Consultar de nuevo</a>
            )}
        </section>
    </div>
</PanelLayout>
