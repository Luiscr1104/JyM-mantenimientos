---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import MapPicker from '@/components/panel/MapPicker';
import { getPropertyWithClient } from '@/server/properties';
import { getPropertyDeletionStatus } from '@/server/properties';
import PropertyDeleteForm from '@/components/panel/PropertyDeleteForm';
import { getServicePlan } from '@/server/service-plans';
import { listPropertyProducts } from '@/server/visit-products';
import { getOpenWaterTaskForProperty, listWaterTaskHistory } from '@/server/water-fill';
import WaterFillWidget from '@/components/panel/WaterFillWidget';
import { formatDateTime } from '@/lib/format';
import { productInfo } from '@/lib/products';
import { formatCompactDate } from '@/lib/dates';

const id = Astro.params.id;
if (!id) return Astro.redirect('/panel/clientes');

const data = await getPropertyWithClient(id);
if (!data) return Astro.redirect('/panel/clientes');

const { property, client } = data;
const deletion = await getPropertyDeletionStatus(property.id);
const plan = await getServicePlan(property.id);
const [productHistory, waterHistory, activeWaterTask] = await Promise.all([
    listPropertyProducts(property.id),
    listWaterTaskHistory(property.id),
    getOpenWaterTaskForProperty(property.id),
]);
const hasLocation = property.lat != null && property.lng != null;

const dayLabels: Record<string, string> = {
    lunes: 'Lun',
    martes: 'Mar',
    miercoles: 'Mié',
    jueves: 'Jue',
    viernes: 'Vie',
    sabado: 'Sáb',
    domingo: 'Dom',
};

const planDays =
    plan && plan.preferredDays && plan.preferredDays.length > 0
        ? plan.preferredDays.map((day) => dayLabels[day] ?? day).join(' · ')
        : 'Automático';

const poolDetails = [
    { label: 'Tipo de piscina', value: property.poolType },
    { label: 'Volumen', value: property.volumeM3 != null ? `${property.volumeM3} m³` : null },
    { label: 'Filtro', value: property.filterType },
    { label: 'Sanitización', value: property.sanitation },
].filter((item) => item.value);

const accessDetails = [
    { label: 'Código de portón', value: property.gateCode },
    { label: 'Notas de acceso', value: property.accessNotes },
    { label: 'Bomba y equipos', value: property.pumpNotes },
].filter((item) => item.value);
---

<PanelLayout title={property.alias}>
    <PageHeader title={property.alias} description={property.address}>
        <a
            href={`/panel/clientes/${client.id}`}
            class="inline-flex h-10 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
            {client.name}
        </a>
        <a
            href={`/panel/propiedades/${property.id}/editar`}
            class="inline-flex h-10 items-center justify-center rounded-xl bg-sky-700 px-4 text-sm font-bold text-white transition hover:bg-sky-800"
        >
            Editar
        </a>
    </PageHeader>

    <div class="grid gap-4 lg:grid-cols-5">
        <div class="space-y-4 lg:col-span-2">
            <WaterFillWidget client:load
                initial={activeWaterTask ? [{
                    id: activeWaterTask.id,
                    propertyId: property.id,
                    propertyName: property.alias,
                    visitId: activeWaterTask.visitId,
                    createdAt: activeWaterTask.createdAt.toISOString(),
                    dueAt: activeWaterTask.dueAt.toISOString(),
                    delayMinutes: activeWaterTask.delayMinutes,
                }] : []}
                propertyId={property.id} propertyName={property.alias} canCreate
            />
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-3 text-base font-extrabold text-slate-900">La piscina</h2>
                {
                    poolDetails.length === 0 ? (
                        <p class="text-sm text-slate-500">
                            Aún no hay datos de la piscina. Edita la propiedad para agregarlos.
                        </p>
                    ) : (
                        <dl class="space-y-3">
                            {poolDetails.map((item) => (
                                <div>
                                    <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">
                                        {item.label}
                                    </dt>
                                    <dd class="mt-0.5 text-sm font-medium text-slate-800">
                                        {item.value}
                                    </dd>
                                </div>
                            ))}
                        </dl>
                    )
                }
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-3 text-base font-extrabold text-slate-900">Acceso</h2>
                {
                    accessDetails.length === 0 ? (
                        <p class="text-sm text-slate-500">
                            Agrega el código del portón y notas de acceso para no perder tiempo en
                            la visita.
                        </p>
                    ) : (
                        <dl class="space-y-3">
                            {accessDetails.map((item) => (
                                <div>
                                    <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">
                                        {item.label}
                                    </dt>
                                    <dd class="mt-0.5 whitespace-pre-line text-sm font-medium text-slate-800">
                                        {item.value}
                                    </dd>
                                </div>
                            ))}
                        </dl>
                    )
                }
            </section>
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="mb-3 flex items-center justify-between">
                    <h2 class="text-base font-extrabold text-slate-900">Frecuencia de servicio</h2>
                    <a
                        href={`/panel/propiedades/${property.id}/editar#frecuencia`}
                        class="text-xs font-bold text-sky-700 hover:underline"
                    >
                        Editar
                    </a>
                </div>

                {
                    plan ? (
                        <dl class="space-y-3">
                            <div>
                                <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">
                                    Visitas por semana
                                </dt>
                                <dd class="mt-0.5 text-sm font-medium text-slate-800">
                                    {plan.visitsPerWeek}
                                </dd>
                            </div>
                            <div>
                                <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">
                                    Días preferidos
                                </dt>
                                <dd class="mt-0.5 text-sm font-medium text-slate-800">
                                    {planDays}
                                </dd>
                            </div>
                            <div>
                                <dt class="text-xs font-bold uppercase tracking-wide text-slate-400">
                                    Estado
                                </dt>
                                <dd class="mt-0.5">
                                    <span
                                        class:list={[
                                            'rounded-full border px-2 py-0.5 text-[11px] font-bold',
                                            plan.active
                                                ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                                                : 'border-slate-200 bg-slate-50 text-slate-500',
                                        ]}
                                    >
                                        {plan.active ? 'Plan activo' : 'Plan pausado'}
                                    </span>
                                </dd>
                            </div>
                        </dl>
                    ) : (
                        <div>
                            <p class="text-sm text-slate-500">
                                Sin frecuencia configurada. Defínela para que esta propiedad
                                aparezca en las sugerencias de la agenda.
                            </p>
                            <a
                                href={`/panel/propiedades/${property.id}/editar#frecuencia`}
                                class="mt-3 inline-flex h-9 items-center rounded-lg bg-sky-700 px-3 text-xs font-bold text-white"
                            >
                                Configurar frecuencia
                            </a>
                        </div>
                    )
                }
            </section>
            <PropertyDeleteForm client:load
                propertyId={property.id} clientId={client.id}
                clientName={client.name} alias={property.alias} address={property.address}
                scheduledVisits={deletion.scheduledVisits} issue={deletion.issue}
            />
        </div>

        <section class="lg:col-span-3">
            <div class="mb-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-base font-extrabold text-slate-900">Productos aplicados</h2>
                {productHistory.length === 0 ? (
                    <p class="mt-2 text-sm text-slate-500">Aún no hay productos registrados.</p>
                ) : (
                    <ul class="mt-3 divide-y divide-slate-100">
                        {productHistory.map(({ product, visit }) => (
                            <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
                                <a href={`/panel/visitas/${visit.id}`} class="font-semibold text-sky-800 hover:underline">
                                    {productInfo(product.product).label} · {formatCompactDate(visit.scheduledFor)}
                                </a>
                                <strong class="text-slate-800">
                                    {Number(product.quantity).toLocaleString('es-CR')} {productInfo(product.product).unit}
                                </strong>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
            {waterHistory.length > 0 && (
                <div class="mb-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <h2 class="text-base font-extrabold text-slate-900">Llenados registrados</h2>
                    <ul class="mt-3 divide-y divide-slate-100 text-sm">
                        {waterHistory.map(({ task, openedByName, closedByName }) => (
                            <li class="flex flex-wrap justify-between gap-2 py-2">
                                <span>{formatDateTime(task.createdAt)} · {openedByName} · volver en {task.delayMinutes} min</span>
                                <strong class={task.closedAt ? 'text-emerald-800' : 'text-red-700'}>
                                    {task.closedAt ? `Cerrada ${formatDateTime(task.closedAt)} por ${closedByName}` : 'Llave pendiente'}
                                </strong>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="mb-3 flex items-center justify-between gap-3">
                    <h2 class="text-base font-extrabold text-slate-900">Ubicación</h2>
                    {
                        hasLocation && (
                            <a
                                href={`https://www.google.com/maps/dir/?api=1&destination=${property.lat},${property.lng}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-xs font-bold text-sky-700 hover:underline"
                            >
                                Cómo llegar →
                            </a>
                        )
                    }
                </div>

                {
                    hasLocation ? (
                        <MapPicker
                            client:only="react"
                            lat={property.lat}
                            lng={property.lng}
                            readOnly
                            height={360}
                        />
                    ) : (
                        <div class="flex h-72 flex-col items-center justify-center rounded-xl border border-dashed border-amber-300 bg-amber-50 px-6 text-center">
                            <p class="text-sm font-bold text-amber-800">Sin ubicación marcada</p>
                            <p class="mt-1 text-xs text-amber-700">
                                Edita la propiedad y toca el mapa para guardar el punto exacto.
                            </p>
                            <a
                                href={`/panel/propiedades/${property.id}/editar`}
                                class="mt-3 inline-flex h-9 items-center justify-center rounded-lg bg-amber-600 px-3 text-xs font-bold text-white"
                            >
                                Marcar ubicación
                            </a>
                        </div>
                    )
                }
            </div>
        </section>
    </div>
</PanelLayout>
