---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import { countClients } from '@/server/clients';
import { countProperties } from '@/server/properties';
import { countNewLeads, getRecentLeads } from '@/server/leads';
import { formatRelative, leadStatusLabel, leadStatusStyle } from '@/lib/format';

const [activeClients, totalProperties, newLeads, recentLeads] = await Promise.all([
    countClients('active'),
    countProperties(),
    countNewLeads(),
    getRecentLeads(4),
]);

const today = new Intl.DateTimeFormat('es-CR', {
    timeZone: 'America/Costa_Rica',
    weekday: 'long',
    day: 'numeric',
    month: 'long',
}).format(new Date());

const todayLabel = today.charAt(0).toUpperCase() + today.slice(1);

const stats = [
    {
        label: 'Clientes activos',
        value: activeClients,
        href: '/panel/clientes',
        hint: 'Ver clientes',
    },
    {
        label: 'Propiedades',
        value: totalProperties,
        href: '/panel/clientes',
        hint: 'Piscinas registradas',
    },
    {
        label: 'Leads nuevos',
        value: newLeads,
        href: '/panel/leads',
        hint: newLeads > 0 ? 'Requieren respuesta' : 'Todo al día',
        highlight: newLeads > 0,
    },
];
---

<PanelLayout title="Hoy">
    <PageHeader title="Hoy" description={todayLabel} />

    <div class="space-y-6">
        <div class="grid gap-3 sm:grid-cols-3">
            {
                stats.map((stat) => (
                    <a
                        href={stat.href}
                        class:list={[
                            'rounded-2xl border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md',
                            stat.highlight ? 'border-sky-300 ring-2 ring-sky-100' : 'border-slate-200',
                        ]}
                    >
                        <p class="text-xs font-bold uppercase tracking-wide text-slate-500">
                            {stat.label}
                        </p>
                        <p class="mt-2 text-3xl font-extrabold text-slate-900">{stat.value}</p>
                        <p
                            class:list={[
                                'mt-1 text-xs font-semibold',
                                stat.highlight ? 'text-sky-700' : 'text-slate-400',
                            ]}
                        >
                            {stat.hint}
                        </p>
                    </a>
                ))
            }
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-base font-extrabold text-slate-900">Primeros pasos</h2>
                    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-slate-500">
                        Fase 1
                    </span>
                </div>
                <ul class="space-y-3 text-sm">
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-700">
                            ✓
                        </span>
                        <span class="text-slate-600">Base de datos y login funcionando</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span
                            class:list={[
                                'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold',
                                totalProperties > 0
                                    ? 'bg-emerald-100 text-emerald-700'
                                    : 'bg-slate-100 text-slate-400',
                            ]}
                        >
                            {totalProperties > 0 ? '✓' : '2'}
                        </span>
                        <span class="text-slate-600">Agrega tu primer cliente y su piscina</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-400">
                            3
                        </span>
                        <span class="text-slate-600">Configura la dirección base de las rutas</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-400">
                            4
                        </span>
                        <span class="text-slate-400">Rutas optimizadas y modo visita (Fase 2)</span>
                    </li>
                </ul>

                <div class="mt-5 flex flex-wrap gap-2">
                    <a
                        href="/panel/clientes/nuevo"
                        class="inline-flex h-10 items-center justify-center rounded-xl bg-sky-700 px-4 text-sm font-bold text-white transition hover:bg-sky-800"
                    >
                        + Nuevo cliente
                    </a>
                    <a
                        href="/panel/ajustes"
                        class="inline-flex h-10 items-center justify-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    >
                        Configurar base
                    </a>
                </div>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-base font-extrabold text-slate-900">Últimos leads</h2>
                    <a href="/panel/leads" class="text-xs font-bold text-sky-700 hover:underline">
                        Ver todos →
                    </a>
                </div>

                {
                    recentLeads.length === 0 ? (
                        <p class="rounded-xl bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
                            Aún no hay mensajes desde el sitio web.
                        </p>
                    ) : (
                        <ul class="divide-y divide-slate-100">
                            {recentLeads.map((lead) => (
                                <li class="flex items-start justify-between gap-3 py-3">
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-bold text-slate-900">
                                            {lead.name}
                                        </p>
                                        <p class="truncate text-xs text-slate-500">{lead.phone}</p>
                                        <p class="mt-0.5 text-[11px] text-slate-400">
                                            {formatRelative(lead.createdAt)}
                                        </p>
                                    </div>
                                    <span
                                        class:list={[
                                            'shrink-0 rounded-full border px-2.5 py-0.5 text-[11px] font-bold',
                                            leadStatusStyle(lead.status),
                                        ]}
                                    >
                                        {leadStatusLabel(lead.status)}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    )
                }
            </section>
        </div>

        <section
            class="rounded-2xl border border-dashed border-slate-300 bg-white/60 p-5 text-sm text-slate-500"
        >
            <p class="font-semibold text-slate-700">Siguiente fase: el planificador</p>
            <p class="mt-1">
                Aquí aparecerá tu ruta del día, las paradas ordenadas por cercanía y los
                recordatorios de bomba y cloro. Por ahora deja listos tus clientes y propiedades.
            </p>
        </section>
    </div>
</PanelLayout>
