---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import TodayVisitCard from '@/components/panel/TodayVisitCard.astro';
import TodayVisitRow from '@/components/panel/TodayVisitRow.astro';
import { formatLongDate, getToday } from '@/lib/dates';
import {
    formatDistance,
    formatDuration,
    formatTime,
    formatRelative,
    leadStatusLabel,
    leadStatusStyle,
} from '@/lib/format';
import { countClients } from '@/server/clients';
import { getRecentLeads, countNewLeads } from '@/server/leads';
import { countProperties } from '@/server/properties';
import { getRoutePlan } from '@/server/routes';
import { getSettings } from '@/server/settings';
import { listVisitsByDate, suggestVisits } from '@/server/visits';
import WaterFillWidget from '@/components/panel/WaterFillWidget';
import { listOpenWaterTasks } from '@/server/water-fill';
import { listRunningPumps } from '@/server/visit-work';
import { listMyReminders } from '@/server/personal-reminders';

const today = getToday();
const openWaterTasks = await listOpenWaterTasks();
const runningPumps = await listRunningPumps();
const myReminders = await listMyReminders(Astro.locals.user!.id);

const dayVisits = await listVisitsByDate(today);
const routePlan = await getRoutePlan(today);
const settings = await getSettings();
const newLeads = await countNewLeads();
const recentLeads = await getRecentLeads(3);
const activeClients = await countClients('active');
const totalProperties = await countProperties();

const suggestions = dayVisits.length === 0 ? await suggestVisits(today) : [];
const completed = dayVisits.filter((row) => row.visit.status === 'completed').length;
const upcomingVisits = [
    ...dayVisits.filter((row) => row.visit.status === 'in_progress'),
    ...dayVisits.filter((row) => row.visit.status === 'scheduled'),
];
const completedVisits = dayVisits.filter((row) => row.visit.status === 'completed');
const pending = upcomingVisits.length;
const featuredVisit = upcomingVisits[0];
const visitOrder = new Map(dayVisits.map((row, index) => [row.visit.id, index]));
const completionPercent = dayVisits.length ? Math.round((completed / dayVisits.length) * 100) : 0;
const hasRouteEstimate = routePlan?.source !== 'manual' && routePlan?.distanceMeters != null && routePlan.durationSeconds != null;
const hasBase = settings.baseLat != null && settings.baseLng != null;

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');

const stats = [
    { label: 'Clientes', value: activeClients, href: '/panel/clientes' },
    { label: 'Propiedades', value: totalProperties, href: '/panel/clientes' },
    { label: 'Leads nuevos', value: newLeads, href: '/panel/leads' },
];
---

<PanelLayout title="Hoy">
    <PageHeader title="Hoy" description={formatLongDate(today)} />

    <div class="space-y-5">
        <section class="rounded-2xl border border-sky-200 bg-white p-4 shadow-sm sm:p-5">
            <h2 class="text-lg font-extrabold text-slate-900">Mis recordatorios</h2>
            {myReminders.length ? (
                <ul class="mt-3 space-y-2">
                    {myReminders.map((reminder) => (
                        <li class="flex items-center justify-between gap-3 rounded-xl bg-sky-50 p-3">
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-slate-900">{reminder.title}</p>
                                <p class="text-xs text-slate-600">{reminder.dueDate === today ? 'Hoy' : `Pendiente del ${reminder.dueDate}`}
                                    {reminder.dueAt ? ` · ${formatTime(reminder.dueAt)}` : ''}
                                </p>
                            </div>
                            <form action={`/api/panel/reminders/${reminder.id}`} method="POST">
                                <button type="submit" class="min-h-11 rounded-lg bg-sky-700 px-3 text-sm font-bold text-white"
                                    aria-label={`Marcar como hecho: ${reminder.title}`}>Hecho</button>
                            </form>
                        </li>
                    ))}
                </ul>
            ) : <p class="mt-2 text-sm text-slate-500">Sin recordatorios pendientes para hoy.</p>}
        </section>
        {runningPumps.length > 0 && (
            <section class="rounded-2xl border border-amber-300 bg-amber-50 p-4 shadow-sm sm:p-5">
                <h2 class="font-extrabold text-amber-950">Bombas pendientes de verificar</h2>
                <p class="mt-1 text-xs text-amber-900">El temporizador no controla los equipos; comprueba su estado físicamente.</p>
                <ul class="mt-3 space-y-2">
                    {runningPumps.map(({ visit, alias }) => (
                        <li>
                            <a class="font-semibold text-sky-800 underline" href={`/panel/visitas/${visit.id}`}>
                                {alias} · Encendido registrado {formatTime(visit.pumpStartedAt!)}
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )}
        {openWaterTasks.length > 0 && (
            <div>
                <WaterFillWidget client:load compact initial={openWaterTasks.map(({ task, property }) => ({
                    id: task.id,
                    propertyId: property.id,
                    propertyName: property.alias,
                    visitId: task.visitId,
                    createdAt: task.createdAt.toISOString(),
                    dueAt: task.dueAt.toISOString(),
                    delayMinutes: task.delayMinutes,
                }))} />
            </div>
        )}
        {
            ok === 'route' && (
                <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
                    Ruta optimizada.
                </div>
            )
        }
        {
            error && (
                <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                    {error}
                </div>
            )
        }

        <section class:list={[
            'relative overflow-hidden rounded-3xl border p-5 shadow-sm sm:p-7',
            dayVisits.length > 0 && pending === 0
                ? 'border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-white'
                : 'border-sky-200 bg-gradient-to-br from-sky-50 via-white to-white',
        ]}>
            <span class:list={[
                'pointer-events-none absolute -right-12 -top-16 h-44 w-44 rounded-full',
                dayVisits.length > 0 && pending === 0 ? 'bg-emerald-100/60' : 'bg-sky-100/70',
            ]} aria-hidden="true"></span>
            {
                dayVisits.length === 0 ? (
                    suggestions.length > 0 ? (
                        <div class="relative">
                            <p class="text-xs font-extrabold uppercase tracking-wider text-sky-800">
                                Prepara tu jornada
                            </p>
                            <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
                                Hay {suggestions.length}{' '}
                                {suggestions.length === 1 ? 'visita' : 'visitas'} para hoy
                            </h2>
                            <p class="mt-2 max-w-xl text-sm text-slate-600">
                                Según la frecuencia de cada propiedad. Confírmalas para armar la
                                ruta.
                            </p>

                            <ul class="mt-5 max-w-xl space-y-2 rounded-2xl border border-sky-100 bg-white/80 p-4 text-sm text-slate-700">
                                {suggestions.slice(0, 4).map((item) => (
                                    <li class="flex min-w-0 items-center gap-2">
                                        <span class="h-2 w-2 shrink-0 rounded-full bg-sky-600" />
                                        <span class="min-w-0 truncate"><strong>{item.alias}</strong> · {item.clientName}</span>
                                    </li>
                                ))}
                                {suggestions.length > 4 && (
                                    <li class="pl-4 text-xs text-slate-500">
                                        y {suggestions.length - 4} más…
                                    </li>
                                )}
                            </ul>

                            <form method="POST" action="/api/panel/visits/suggest" class="mt-5">
                                <input type="hidden" name="date" value={today} />
                                <button
                                    type="submit"
                                    class="panel-btn panel-btn-primary panel-btn-main w-full sm:w-auto"
                                >
                                    Confirmar visitas de hoy
                                </button>
                            </form>
                        </div>
                    ) : (
                        <div class="relative">
                            <p class="text-xs font-extrabold uppercase tracking-wider text-sky-800">Tu jornada</p>
                            <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
                                No hay visitas para hoy
                            </h2>
                            <p class="mt-2 max-w-xl text-sm text-slate-600">
                                Programa una visita manualmente o define la frecuencia de tus
                                propiedades para que aparezcan solas.
                            </p>
                            <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                                <a
                                    href={`/panel/agenda?date=${today}`}
                                    class="panel-btn panel-btn-primary panel-btn-main"
                                >
                                    Agregar visita
                                </a>
                                <a
                                    href="/panel/clientes"
                                    class="panel-btn panel-btn-secondary"
                                >
                                    Configurar frecuencia
                                </a>
                            </div>
                        </div>
                    )
                ) : (
                    <div class="relative">
                        <p class:list={[
                            'text-xs font-extrabold uppercase tracking-wider',
                            pending === 0 ? 'text-emerald-800' : 'text-sky-800',
                        ]}>Tu jornada</p>
                        <h2 class="mt-2 pr-6 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
                            {pending === 0
                                ? 'Jornada completada'
                                : `Te ${pending === 1 ? 'queda' : 'quedan'} ${pending} ${pending === 1 ? 'visita' : 'visitas'}`}
                        </h2>

                        {pending === 0 ? (
                            <p class="mt-2 text-sm text-slate-600">No quedan visitas pendientes hoy.</p>
                        ) : routePlan?.source === 'manual' ? (
                            <p class="mt-2 text-sm text-slate-600">Orden ajustado manualmente · consulta la ruta para recorrer las paradas.</p>
                        ) : hasRouteEstimate ? (
                            <p class="mt-2 text-sm text-slate-600">
                                Ruta calculada · {formatDistance(routePlan!.distanceMeters)} ·{' '}
                                {formatDuration(routePlan!.durationSeconds)} de recorrido
                                {routePlan!.source === 'fallback' && ' (estimado)'}.
                            </p>
                        ) : routePlan ? (
                            <p class="mt-2 text-sm text-slate-600">Ruta lista · tiempo y distancia no disponibles.</p>
                        ) : hasBase ? (
                            <p class="mt-2 text-sm text-slate-600">
                                Organiza el recorrido para empezar.
                            </p>
                        ) : (
                            <p class="mt-2 max-w-xl text-sm text-slate-600">
                                Abre Ruta para usar tu ubicación actual o configura la base en Ajustes.
                            </p>
                        )}

                        <div class="mt-6 max-w-2xl rounded-2xl border border-white bg-white/80 p-4 shadow-sm sm:p-5">
                            <div class="flex flex-wrap items-end justify-between gap-2">
                                <p class="text-sm font-semibold text-slate-700">Visitas completadas</p>
                                <p class="text-xl font-extrabold text-slate-900">{completed} <span class="text-sm font-semibold text-slate-500">de {dayVisits.length}</span></p>
                            </div>
                            <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100"
                                role="progressbar" aria-label="Visitas completadas hoy" aria-valuemin="0" aria-valuemax="100" aria-valuenow={completionPercent}>
                                <div class:list={['h-full rounded-full', pending === 0 ? 'bg-emerald-600' : 'bg-sky-600']}
                                    style={`width: ${completionPercent}%`}></div>
                            </div>
                            <p class="mt-2 text-xs font-medium text-slate-500">{completionPercent}% de las visitas de hoy</p>
                        </div>
                        <div class="mt-5 flex flex-wrap items-center gap-2">
                            {pending > 0 && (
                                <a href={`/panel/ruta?date=${today}`}
                                    class="panel-btn panel-btn-primary w-full sm:w-auto">
                                    {routePlan ? 'Ver ruta' : 'Optimizar ruta'}
                                </a>
                            )}
                            <a href={`/panel/agenda?date=${today}`}
                                class="panel-btn panel-btn-secondary w-full sm:w-auto">
                                {pending === 0 ? 'Ver agenda' : 'Editar agenda'}
                            </a>
                            <a href="/panel/reportes"
                                class="inline-flex min-h-12 items-center px-2 text-sm font-bold text-sky-800 hover:underline">
                                Reporte semanal →
                            </a>
                        </div>
                    </div>
                )
            }
        </section>

        {upcomingVisits.length > 0 && (
            <section>
                <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
                    <h2 class="text-lg font-extrabold text-slate-900">Paradas por atender</h2>
                    <span class="text-xs font-semibold text-slate-500">{upcomingVisits.length} por atender</span>
                </div>
                <ul class="space-y-2">
                    {upcomingVisits.map((row) => (
                        <TodayVisitRow row={row} index={visitOrder.get(row.visit.id)!}
                            featured={row.visit.id === featuredVisit?.visit.id} />
                    ))}
                </ul>
            </section>
        )}

        {completedVisits.length > 0 && (
            <details class="group rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 shadow-sm sm:p-5">
                <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3 font-extrabold text-emerald-900">
                    <span>Visitas completadas <span class="text-sm font-semibold">({completedVisits.length})</span></span>
                    <span class="text-xl transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
                </summary>
                <ul class="mt-3 grid gap-3 lg:grid-cols-2">
                    {completedVisits.map((row) => (
                        <TodayVisitCard row={row} index={visitOrder.get(row.visit.id)!} />
                    ))}
                </ul>
            </details>
        )}

        {
            !hasBase && (
                <a
                    href="/panel/ajustes"
                    class="flex items-center justify-between gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"
                >
                    <span>
                        <span class="font-bold">Falta la ubicación base.</span> Hoy puedes iniciar desde tu GPS;
                        configura la base para rutas de otros días.
                    </span>
                    <span class="shrink-0 font-bold">Configurar →</span>
                </a>
            )
        }

        <section aria-label="Resumen del negocio">
            <h2 class="mb-3 text-base font-extrabold text-slate-900">Vista general</h2>
            <div class="grid grid-cols-3 gap-2 sm:gap-3">
                {
                    stats.map((stat) => (
                        <a
                            href={stat.href}
                            class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm transition hover:border-sky-200 hover:bg-sky-50 hover:shadow-md sm:p-5"
                        >
                            <p class="text-xs font-bold text-slate-600">
                                {stat.label}
                            </p>
                            <p class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{stat.value}</p>
                            <span class="mt-2 hidden text-xs font-bold text-sky-800 sm:block">Ver detalle →</span>
                        </a>
                    ))
                }
            </div>
        </section>

        {
            recentLeads.length > 0 && (
                <details class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
                    <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3">
                        <span class="font-extrabold text-slate-900">Últimos leads <span class="text-sm font-semibold text-slate-500">({recentLeads.length})</span></span>
                        <span class="text-xl text-sky-700 transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
                    </summary>
                    <ul class="mt-2 divide-y divide-slate-100">
                        {recentLeads.map((lead) => (
                            <li class="flex items-start justify-between gap-3 py-3">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-bold text-slate-900">
                                        {lead.name}
                                    </p>
                                    <p class="truncate text-xs text-slate-500">{lead.phone}</p>
                                    <p class="mt-0.5 text-[11px] text-slate-400">
                                        {formatRelative(lead.createdAt)}
                                    </p>
                                </div>
                                <span
                                    class:list={[
                                        'shrink-0 rounded-full border px-2.5 py-0.5 text-[11px] font-bold',
                                        leadStatusStyle(lead.status),
                                    ]}
                                >
                                    {leadStatusLabel(lead.status)}
                                </span>
                            </li>
                        ))}
                    </ul>
                    <a href="/panel/leads" class="mt-3 inline-flex min-h-11 items-center text-sm font-bold text-sky-800 hover:underline">Ver todos los leads →</a>
                </details>
            )
        }
    </div>
</PanelLayout>
