---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import { formatLongDate, getToday } from '@/lib/dates';
import {
    formatDistance,
    formatDuration,
    formatTime,
    formatVisitDuration,
    formatRelative,
    leadStatusLabel,
    leadStatusStyle,
    visitStatusLabel,
    visitStatusStyle,
} from '@/lib/format';
import { countClients } from '@/server/clients';
import { getRecentLeads, countNewLeads } from '@/server/leads';
import { countProperties } from '@/server/properties';
import { getRoutePlan } from '@/server/routes';
import { getSettings } from '@/server/settings';
import { listVisitsByDate, suggestVisits } from '@/server/visits';
import WaterFillWidget from '@/components/panel/WaterFillWidget';
import { listOpenWaterTasks } from '@/server/water-fill';
import { workTypesLabel } from '@/lib/visit-types';

const today = getToday();
const openWaterTasks = await listOpenWaterTasks();

const dayVisits = await listVisitsByDate(today);
const routePlan = await getRoutePlan(today);
const settings = await getSettings();
const newLeads = await countNewLeads();
const recentLeads = await getRecentLeads(3);
const activeClients = await countClients('active');
const totalProperties = await countProperties();

const suggestions = dayVisits.length === 0 ? await suggestVisits(today) : [];
const completed = dayVisits.filter((row) => row.visit.status === 'completed').length;
const pending = dayVisits.filter((row) => row.visit.status === 'scheduled' || row.visit.status === 'in_progress').length;
const hasBase = settings.baseLat != null && settings.baseLng != null;

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');

const stats = [
    { label: 'Clientes', value: activeClients, href: '/panel/clientes' },
    { label: 'Propiedades', value: totalProperties, href: '/panel/clientes' },
    { label: 'Leads nuevos', value: newLeads, href: '/panel/leads' },
];
---

<PanelLayout title="Hoy">
    <PageHeader title="Hoy" description={formatLongDate(today)} />

    <div class="space-y-5">
        {openWaterTasks.length > 0 && (
            <WaterFillWidget client:load initial={openWaterTasks.map(({ task, property }) => ({
                id: task.id,
                propertyId: property.id,
                propertyName: property.alias,
                visitId: task.visitId,
                createdAt: task.createdAt.toISOString(),
                dueAt: task.dueAt.toISOString(),
                delayMinutes: task.delayMinutes,
            }))} />
        )}
        {
            ok === 'route' && (
                <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
                    Ruta optimizada.
                </div>
            )
        }
        {
            error && (
                <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                    {error}
                </div>
            )
        }

        <section class:list={[
            'border shadow-sm',
            dayVisits.length > 0
                ? [
                    'rounded-2xl border-slate-200 border-l-4 bg-white p-5 sm:p-6',
                    pending > 0 ? 'border-l-sky-600' : 'border-l-emerald-600',
                ]
                : 'rounded-3xl border-sky-200 bg-gradient-to-br from-sky-50 via-white to-white p-5 sm:p-7',
        ]}>
            {
                dayVisits.length === 0 ? (
                    suggestions.length > 0 ? (
                        <div>
                            <p class="text-xs font-bold uppercase tracking-wide text-sky-700">
                                Sugerencia del día
                            </p>
                            <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900">
                                Hay {suggestions.length}{' '}
                                {suggestions.length === 1 ? 'visita' : 'visitas'} para hoy
                            </h2>
                            <p class="mt-1 text-sm text-slate-600">
                                Según la frecuencia de cada propiedad. Confírmalas para armar la
                                ruta.
                            </p>

                            <ul class="mt-4 space-y-1 text-sm text-slate-700">
                                {suggestions.slice(0, 4).map((item) => (
                                    <li class="flex items-center gap-2">
                                        <span class="h-1.5 w-1.5 rounded-full bg-sky-600" />
                                        <span class="font-semibold">{item.alias}</span>
                                        <span class="text-slate-400">·</span>
                                        <span class="text-slate-500">{item.clientName}</span>
                                    </li>
                                ))}
                                {suggestions.length > 4 && (
                                    <li class="text-xs text-slate-500">
                                        y {suggestions.length - 4} más…
                                    </li>
                                )}
                            </ul>

                            <form method="POST" action="/api/panel/visits/suggest" class="mt-5">
                                <input type="hidden" name="date" value={today} />
                                <button
                                    type="submit"
                                    class="panel-btn panel-btn-primary panel-btn-main w-full sm:w-auto"
                                >
                                    Confirmar visitas de hoy
                                </button>
                            </form>
                        </div>
                    ) : (
                        <div>
                            <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
                                No hay visitas para hoy
                            </h2>
                            <p class="mt-1 max-w-xl text-sm text-slate-600">
                                Programa una visita manualmente o define la frecuencia de tus
                                propiedades para que aparezcan solas.
                            </p>
                            <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                                <a
                                    href={`/panel/agenda?date=${today}`}
                                    class="panel-btn panel-btn-primary panel-btn-main"
                                >
                                    Agregar visita
                                </a>
                                <a
                                    href="/panel/clientes"
                                    class="panel-btn panel-btn-secondary"
                                >
                                    Configurar frecuencia
                                </a>
                            </div>
                        </div>
                    )
                ) : (
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wide text-slate-500">
                            Tu jornada
                        </p>
                        <h2 class="mt-1 text-xl font-extrabold tracking-tight text-slate-900 sm:text-2xl">
                            {pending === 0
                                ? 'Jornada completada'
                                : `Te ${pending === 1 ? 'queda' : 'quedan'} ${pending} ${pending === 1 ? 'visita' : 'visitas'}`}
                        </h2>

                        {pending === 0 ? (
                            <p class="mt-1 text-sm text-slate-600">No quedan visitas por hacer hoy.</p>
                        ) : routePlan ? (
                            <p class="mt-1 text-sm text-slate-600">
                                Ruta lista · {formatDistance(routePlan.distanceMeters)} ·{' '}
                                {formatDuration(routePlan.durationSeconds)} de recorrido
                                {routePlan.source === 'fallback' && ' (estimado)'}.
                            </p>
                        ) : hasBase ? (
                            <p class="mt-1 text-sm text-slate-600">
                                Organiza el recorrido para empezar.
                            </p>
                        ) : (
                            <p class="mt-1 max-w-xl text-sm text-slate-600">
                                Abre Ruta para usar tu ubicación actual o configura la base en Ajustes.
                            </p>
                        )}

                        <div class="mt-4 border-t border-slate-100 pt-4">
                            <p class="text-sm font-medium text-slate-600">
                                {completed} de {dayVisits.length}{' '}
                                {dayVisits.length === 1 ? 'visita completada' : 'visitas completadas'}
                            </p>
                            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                                {pending === 0 ? null : (
                                    <a
                                        href={`/panel/ruta?date=${today}`}
                                        class="panel-btn panel-btn-primary"
                                    >
                                        {routePlan ? 'Ver ruta' : 'Optimizar ruta'}
                                    </a>
                                )}
                                <a
                                    href={`/panel/agenda?date=${today}`}
                                    class="inline-flex min-h-12 items-center text-sm font-semibold text-sky-700 hover:underline"
                                >
                                    {pending === 0 ? 'Ver agenda' : 'Editar agenda'} →
                                </a>
                            </div>
                        </div>
                    </div>
                )
            }
        </section>

        {
            dayVisits.length > 0 && (
                <section>
                    <h2 class="mb-3 text-base font-extrabold text-slate-900">Paradas de hoy</h2>
                    <ul class="space-y-2">
                        {dayVisits.map((row, index) => (
                            <li class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4">
                                <div class="flex items-start gap-2">
                                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sm font-extrabold text-sky-800">
                                        {index + 1}
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <a
                                                href={`/panel/propiedades/${row.property.id}`}
                                                class="min-w-0 max-w-full truncate text-base font-extrabold text-slate-900 hover:underline"
                                            >
                                                {row.property.alias}
                                            </a>
                                            <span
                                                class:list={[
                                                    'shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-bold',
                                                    visitStatusStyle(row.visit.status),
                                                ]}
                                            >
                                                {visitStatusLabel(row.visit.status)}
                                            </span>
                                        </div>
                                        <p class="mt-0.5 truncate text-sm text-slate-500">
                                            {row.client.name} · {row.property.address}
                                        </p>
                                        <p class="mt-1 text-xs font-semibold text-sky-800">
                                            {workTypesLabel(row.visit.workTypes)}
                                        </p>
                                        {(row.visit.startedAt || row.visit.leftAt || row.visit.completedAt) && (
                                            <p class="mt-1 text-xs font-semibold text-slate-600">
                                                {row.visit.startedAt && `Llegada ${formatTime(row.visit.startedAt)}`}
                                                {(row.visit.leftAt ?? row.visit.completedAt) &&
                                                    ` · Salida ${formatTime(row.visit.leftAt ?? row.visit.completedAt!)}`}
                                                {formatVisitDuration(row.visit.startedAt, row.visit.leftAt ?? row.visit.completedAt) &&
                                                    ` · ${formatVisitDuration(row.visit.startedAt, row.visit.leftAt ?? row.visit.completedAt)} en propiedad`}
                                            </p>
                                        )}
                                    </div>
                                </div>
                                <div class:list={[
                                    'mt-2 grid gap-2',
                                    row.property.lat != null && row.property.lng != null
                                        ? 'grid-cols-2'
                                        : 'grid-cols-1',
                                ]}>
                                    <a
                                        href={`/panel/visitas/${row.visit.id}`}
                                        class="panel-btn panel-btn-primary min-h-11 w-full px-2 text-xs sm:px-4 sm:text-sm"
                                    >
                                        {row.visit.status === 'scheduled' ? 'Iniciar visita' :
                                            row.visit.status === 'in_progress' ? 'Continuar visita' : 'Ver registro'}
                                    </a>
                                    {row.property.lat != null &&
                                        row.property.lng != null && (
                                            <a
                                                href={`https://www.google.com/maps/dir/?api=1&destination=${row.property.lat},${row.property.lng}&travelmode=driving`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="panel-btn panel-btn-secondary min-h-11 w-full px-2 text-xs sm:px-4 sm:text-sm"
                                            >
                                                Navegar
                                            </a>
                                        )}
                                </div>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            !hasBase && (
                <a
                    href="/panel/ajustes"
                    class="flex items-center justify-between gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"
                >
                    <span>
                        <span class="font-bold">Falta la ubicación base.</span> Sin ella no se pueden
                        calcular las rutas.
                    </span>
                    <span class="font-bold">Configurar →</span>
                </a>
            )
        }

        <div class="grid grid-cols-3 gap-2 sm:gap-3">
            {
                stats.map((stat) => (
                    <a
                        href={stat.href}
                        class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm transition hover:shadow-md sm:p-4"
                    >
                        <p class="text-xs font-bold text-slate-600">
                            {stat.label}
                        </p>
                        <p class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl">{stat.value}</p>
                    </a>
                ))
            }
        </div>

        {
            recentLeads.length > 0 && (
                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="mb-3 flex items-center justify-between">
                        <h2 class="text-base font-extrabold text-slate-900">Últimos leads</h2>
                        <a
                            href="/panel/leads"
                            class="text-xs font-bold text-sky-700 hover:underline"
                        >
                            Ver todos →
                        </a>
                    </div>
                    <ul class="divide-y divide-slate-100">
                        {recentLeads.map((lead) => (
                            <li class="flex items-start justify-between gap-3 py-3">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-bold text-slate-900">
                                        {lead.name}
                                    </p>
                                    <p class="truncate text-xs text-slate-500">{lead.phone}</p>
                                    <p class="mt-0.5 text-[11px] text-slate-400">
                                        {formatRelative(lead.createdAt)}
                                    </p>
                                </div>
                                <span
                                    class:list={[
                                        'shrink-0 rounded-full border px-2.5 py-0.5 text-[11px] font-bold',
                                        leadStatusStyle(lead.status),
                                    ]}
                                >
                                    {leadStatusLabel(lead.status)}
                                </span>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }
    </div>
</PanelLayout>
