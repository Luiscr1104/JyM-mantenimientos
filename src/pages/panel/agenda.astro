---
import PanelLayout from '@/layouts/PanelLayout.astro';
import PageHeader from '@/components/panel/PageHeader.astro';
import DateNav from '@/components/panel/DateNav.astro';
import MonthCalendar from '@/components/panel/MonthCalendar.astro';
import { getToday, isValidDate } from '@/lib/dates';
import { isValidMonth } from '@/lib/agenda-calendar';
import { WORK_TYPES, workTypesLabel } from '@/lib/visit-types';
import { formatTime, formatVisitDuration, visitStatusLabel, visitStatusStyle } from '@/lib/format';
import { listPropertiesWithClient } from '@/server/properties';
import { listVisitCountsByMonth, listVisitsByDate, suggestVisits } from '@/server/visits';

const dateParam = Astro.url.searchParams.get('date');
const date = isValidDate(dateParam) ? dateParam : getToday();
const monthParam = Astro.url.searchParams.get('month');
const month = isValidMonth(monthParam) ? monthParam : date.slice(0, 7);
const calendarOpen = Astro.url.searchParams.get('calendar') === 'month';

const [dayVisits, properties, suggestions, monthCounts] = await Promise.all([
    listVisitsByDate(date, { includeSkipped: true }),
    listPropertiesWithClient(),
    suggestVisits(date),
    listVisitCountsByMonth(month),
]);
const counts = Object.fromEntries(monthCounts.map(({ date, total }) => [date, total]));

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const fromRoute = Astro.url.searchParams.get('from') === 'route';
---

<PanelLayout title="Agenda">
    <PageHeader title="Agenda" description="Agrega o quita visitas y planifica otros días.">
        <a
            href={`/panel/ruta?date=${date}`}
            class:list={['panel-btn', fromRoute ? 'panel-btn-primary' : 'panel-btn-secondary']}
        >
            {fromRoute ? '← Volver a la ruta' : 'Ver ruta'}
        </a>
    </PageHeader>

    <DateNav date={date} basePath="/panel/agenda" fromRoute={fromRoute} />
    <MonthCalendar date={date} month={month} open={calendarOpen} counts={counts} fromRoute={fromRoute} />

    {
        ok === 'suggest' && (
            <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
                Visitas sugeridas agregadas a la agenda.
            </div>
        )
    }
    {ok === 'visit-added' && (
        <p role="status" class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
            Visita agregada. Puedes verla en Ruta.
        </p>
    )}
    {ok === 'visit-exists' && (
        <p role="status" class="mb-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-semibold text-sky-800">
            Esa propiedad ya tiene una visita para este día.
        </p>
    )}
    {ok === 'visit-removed' && (
        <p role="status" class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
            Visita quitada del día.
        </p>
    )}
    {error && (
        <p role="alert" class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">
            {error}
        </p>
    )}

    <section id="gestionar-visitas" class="mb-4 min-w-0 scroll-mt-20 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <h2 class="text-base font-extrabold text-slate-900">Agregar visita</h2>
        <p class="mt-1 text-xs text-slate-500">Se agrega al final de este día. Si ya tenías una ruta calculada, podrás optimizarla otra vez.</p>
        <a href="#visitas-del-dia" class="mt-2 inline-flex min-h-10 items-center text-sm font-semibold text-sky-800 underline">
            ¿Quieres quitar una visita? Ve a la lista ↓
        </a>

        {
            properties.length === 0 ? (
                <a href="/panel/clientes/nuevo" class="panel-btn panel-btn-primary mt-4">
                    + Crear cliente y propiedad
                </a>
            ) : (
                <form method="POST" action="/api/panel/visits"
                    class="mt-3 grid min-w-0 gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end">
                    <input type="hidden" name="scheduledFor" value={date} />
                    <input type="hidden" name="calendar" value={calendarOpen ? 'month' : ''} data-calendar-state />
                    {fromRoute && <input type="hidden" name="returnTo" value="route" />}
                    <div class="min-w-0">
                        <label for="propertyId" class="mb-1 block text-xs font-bold text-slate-700">
                            Propiedad
                        </label>
                        <select id="propertyId" name="propertyId" required
                            class="h-12 min-w-0 w-full rounded-xl border border-slate-300 bg-white px-3 text-base text-slate-900 outline-none transition focus:border-sky-500 focus:ring-4 focus:ring-sky-100">
                            <option value="">Elige una propiedad…</option>
                            {properties.map(({ property, client }) => (
                                <option value={property.id}>{property.alias} · {client.name}</option>
                            ))}
                        </select>
                    </div>
                    <div class="min-w-0">
                        <label for="workType" class="mb-1 block text-xs font-bold text-slate-700">
                            Trabajo previsto
                        </label>
                        <select id="workType" name="workType"
                            class="h-12 min-w-0 w-full rounded-xl border border-slate-300 bg-white px-3 text-base text-slate-900">
                            {WORK_TYPES.filter(({ key }) => key !== 'flocculation_follow_up').map(({ key, label }) => (
                                <option value={key}>{label}</option>
                            ))}
                        </select>
                    </div>
                    <button type="submit" class="panel-btn panel-btn-primary w-full sm:w-auto">
                        Agregar a la agenda
                    </button>
                </form>
            )
        }
    </section>

    <div class="grid min-w-0 grid-cols-1 gap-4 lg:grid-cols-5">
        <section id="visitas-del-dia" class="min-w-0 scroll-mt-20 lg:col-span-3">
            <h2 class="mb-3 text-base font-extrabold text-slate-900">
                Visitas del día
                <span class="ml-1 text-sm font-semibold text-slate-400">({dayVisits.length})</span>
            </h2>
            <p class="mb-3 text-xs text-slate-600">
                Quitar elimina una visita sin historial. Omitir conserva el registro cuando no se atenderá hoy.
            </p>

            {
                dayVisits.length === 0 ? (
                    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-5 text-center sm:p-8">
                        <p class="text-3xl">🗓️</p>
                        <h3 class="mt-2 text-base font-bold text-slate-900">
                            No hay visitas este día
                        </h3>
                        <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">
                            Agrega una visita o usa las sugerencias de este día.
                        </p>
                    </div>
                ) : (
                    <ul class="grid grid-cols-1 gap-2 sm:gap-3">
                        {dayVisits.map((row, index) => (
                            <li class="min-w-0 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4">
                                <div class="flex min-w-0 items-start gap-2">
                                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sm font-extrabold text-sky-800">
                                        {index + 1}
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <a
                                                href={`/panel/propiedades/${row.property.id}`}
                                                class="min-w-0 max-w-full truncate text-base font-extrabold text-slate-900 hover:underline"
                                            >
                                                {row.property.alias}
                                            </a>
                                            <span
                                                class:list={[
                                                    'shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-bold',
                                                    visitStatusStyle(row.visit.status),
                                                ]}
                                            >
                                                {visitStatusLabel(row.visit.status)}
                                            </span>
                                        </div>
                                        <p class="mt-0.5 truncate text-sm text-slate-500">
                                            {row.client.name} · {row.property.address}
                                        </p>
                                        <p class="mt-1 text-xs font-semibold text-sky-800">
                                            {workTypesLabel(row.visit.workTypes)}
                                        </p>
                                        {(row.visit.startedAt || row.visit.leftAt || row.visit.completedAt) && (
                                            <p class="mt-1 text-xs font-semibold text-slate-600">
                                                {row.visit.startedAt && `Llegada ${formatTime(row.visit.startedAt)}`}
                                                {(row.visit.leftAt ?? row.visit.completedAt) &&
                                                    ` · Salida ${formatTime(row.visit.leftAt ?? row.visit.completedAt!)}`}
                                                {formatVisitDuration(row.visit.startedAt, row.visit.leftAt ?? row.visit.completedAt) &&
                                                    ` · ${formatVisitDuration(row.visit.startedAt, row.visit.leftAt ?? row.visit.completedAt)} en propiedad`}
                                            </p>
                                        )}
                                    </div>
                                </div>
                                <div class="mt-3 flex flex-wrap gap-2">
                                    <a href={`/panel/visitas/${row.visit.id}`}
                                        class="panel-btn panel-btn-secondary min-h-11">
                                        Ver visita
                                    </a>
                                    {row.visit.status === 'scheduled' && !row.visit.checklist && (
                                        <form method="POST" action={`/api/panel/visits/${row.visit.id}`}
                                            data-confirm="¿Quitar esta visita del día? Esta acción elimina una visita sin historial.">
                                            <input type="hidden" name="action" value="delete" />
                                            <input type="hidden" name="date" value={date} />
                                            <input type="hidden" name="calendar" value={calendarOpen ? 'month' : ''} data-calendar-state />
                                            {fromRoute && <input type="hidden" name="returnTo" value="route" />}
                                            <button type="submit" class="panel-btn panel-btn-danger min-h-11">
                                                Quitar visita
                                            </button>
                                        </form>
                                    )}
                                </div>
                                <details class="mt-1">
                                    <summary class="inline-flex min-h-11 cursor-pointer items-center text-sm font-semibold text-slate-700 underline">
                                        Más acciones
                                    </summary>
                                    <div class="flex flex-wrap gap-2 pb-1">
                                        {row.visit.status === 'scheduled' ||
                                        row.visit.status === 'in_progress' ? (
                                            <form method="POST" action={`/api/panel/visits/${row.visit.id}`}
                                                data-confirm="¿Omitir esta visita? El registro se conserva.">
                                                <input type="hidden" name="action" value="skip" />
                                                <button type="submit" class="panel-btn panel-btn-secondary">
                                                    Omitir (conservar registro)
                                                </button>
                                            </form>
                                        ) : (
                                            <form method="POST" action={`/api/panel/visits/${row.visit.id}`}>
                                                <input type="hidden" name="action" value="reopen" />
                                                <button type="submit" class="panel-btn panel-btn-secondary">
                                                    Reabrir
                                                </button>
                                            </form>
                                        )}
                                    </div>
                                </details>
                            </li>
                        ))}
                    </ul>
                )
            }
        </section>

            <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:col-span-2 lg:p-5">
                <div class="flex items-center justify-between">
                    <h2 class="text-base font-extrabold text-slate-900">Sugerencias</h2>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-500">
                        {suggestions.length}
                    </span>
                </div>

                {
                    suggestions.length === 0 ? (
                        <p class="mt-2 text-sm text-slate-500">
                            No hay propiedades pendientes según su frecuencia. Puedes ajustarla en
                            la ficha de cada propiedad.
                        </p>
                    ) : (
                        <>
                            <ul class="mt-3 space-y-2 text-sm">
                                {suggestions.map((item) => (
                                    <li class="flex min-w-0 items-start gap-2">
                                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-600" />
                                        <span class="min-w-0">
                                            <span class="break-words font-semibold text-slate-800">
                                                {item.alias}
                                            </span>
                                            <span class="block text-xs text-slate-500">
                                                {item.clientName} · {item.visitsPerWeek}/semana
                                            </span>
                                        </span>
                                    </li>
                                ))}
                            </ul>
                            <form method="POST" action="/api/panel/visits/suggest" class="mt-4">
                                <input type="hidden" name="date" value={date} />
                                <input type="hidden" name="calendar" value={calendarOpen ? 'month' : ''} data-calendar-state />
                                <button
                                    type="submit"
                                    class="panel-btn w-full border border-sky-200 bg-sky-50 text-sky-800 hover:bg-sky-100"
                                >
                                    Agregar {suggestions.length}{' '}
                                    {suggestions.length === 1 ? 'sugerida' : 'sugeridas'}
                                </button>
                            </form>
                        </>
                    )
                }
            </section>
    </div>
</PanelLayout>

<script>
    const calendar = document.querySelector<HTMLDetailsElement>('#calendario-mensual');
    calendar?.addEventListener('toggle', () => {
        document.querySelectorAll<HTMLInputElement>('input[data-calendar-state]').forEach((input) => {
            input.value = calendar.open ? 'month' : '';
        });
    });
    document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
        form.addEventListener('submit', (event) => {
            if (!window.confirm(form.dataset.confirm ?? '¿Confirmar la acción?')) event.preventDefault();
        });
    });
</script>
