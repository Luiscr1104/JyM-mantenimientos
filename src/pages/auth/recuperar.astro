---
import { APP_URL } from 'astro:env/server';
import AuthLayout from '@/layouts/AuthLayout.astro';

const nextParam = Astro.url.searchParams.get('next') ?? '/panel/ajustes/password';
const next = nextParam.startsWith('/panel') ? nextParam : '/panel';

let sent = false;
let error = '';
let email = '';

if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    email = String(form.get('email') ?? '').trim().toLowerCase();

    if (!email) {
        error = 'Escribe tu correo electrónico.';
    } else {
        const { error: resetError } = await Astro.locals.supabase.auth.resetPasswordForEmail(email, {
            redirectTo: `${APP_URL}/auth/callback?next=${encodeURIComponent(next)}`,
        });

        // Por seguridad no revelamos si el correo existe o no.
        if (resetError) {
            console.error('[auth] resetPasswordForEmail:', resetError.message);
        }
        sent = true;
    }
}
---

<AuthLayout title="Recuperar contraseña | JyM Mantenimientos">
    <main class="w-full max-w-md">
        <div class="mb-8 text-center">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Recuperar contraseña</h1>
            <p class="mt-2 text-sm text-slate-500">
                Te enviaremos un enlace para crear una contraseña nueva.
            </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/60 sm:p-8">
            {
                sent ? (
                    <div class="space-y-4 text-center">
                        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl">
                            ✓
                        </div>
                        <p class="text-sm font-medium text-slate-700">
                            Si <span class="font-bold">{email}</span> tiene una cuenta, recibirás un
                            correo con el enlace en unos minutos.
                        </p>
                        <p class="text-xs text-slate-500">
                            Revisa también la carpeta de spam. El enlace caduca por seguridad.
                        </p>
                        <a
                            href="/panel/login"
                            class="inline-flex h-11 items-center justify-center rounded-xl bg-sky-700 px-5 text-sm font-bold text-white transition hover:bg-sky-800"
                        >
                            Volver al login
                        </a>
                    </div>
                ) : (
                    <>
                        {error && (
                            <div
                                role="alert"
                                class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"
                            >
                                {error}
                            </div>
                        )}
                        <form method="POST" class="space-y-5">
                            <div>
                                <label
                                    for="email"
                                    class="mb-1.5 block text-sm font-semibold text-slate-700"
                                >
                                    Correo electrónico
                                </label>
                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    autocomplete="email"
                                    required
                                    value={email}
                                    placeholder="tu@correo.com"
                                    class="h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-base text-slate-900 outline-none transition focus:border-sky-500 focus:ring-4 focus:ring-sky-100"
                                />
                            </div>
                            <button
                                type="submit"
                                class="h-12 w-full rounded-xl bg-sky-700 text-base font-bold text-white transition hover:bg-sky-800 active:scale-[0.99]"
                            >
                                Enviar enlace
                            </button>
                        </form>
                    </>
                )
            }
        </div>

        <a
            href="/panel/login"
            class="mt-6 block text-center text-sm font-medium text-slate-500 transition hover:text-sky-700"
        >
            ← Volver al login
        </a>
    </main>
</AuthLayout>
