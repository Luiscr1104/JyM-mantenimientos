---
import { addDays, formatLongDate, getToday } from '@/lib/dates';

interface Props {
    date: string;
    basePath: string;
}

const { date, basePath } = Astro.props;
const previous = addDays(date, -1);
const next = addDays(date, 1);
const today = getToday();

const href = (value: string) => `${basePath}?date=${value}`;
---

<div
    class="mb-5 flex items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm"
>
    <a
        href={href(previous)}
        aria-label="Día anterior"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-lg font-bold text-slate-500 transition hover:bg-slate-100"
    >
        ←
    </a>

    <div class="min-w-0 text-center">
        <p class="truncate text-sm font-extrabold text-slate-900">{formatLongDate(date)}</p>
        {
            date === today ? (
                <p class="text-[11px] font-bold uppercase tracking-wide text-sky-700">Hoy</p>
            ) : (
                <a href={href(today)} class="text-[11px] font-bold text-sky-700 hover:underline">
                    Ir a hoy
                </a>
            )
        }
    </div>

    <a
        href={href(next)}
        aria-label="Día siguiente"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-lg font-bold text-slate-500 transition hover:bg-slate-100"
    >
        →
    </a>
</div>
