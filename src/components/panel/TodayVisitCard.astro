---
import { formatTime, formatVisitDuration, visitStatusLabel, visitStatusStyle } from '@/lib/format';
import { workTypesLabel } from '@/lib/visit-types';
import type { VisitWithProperty } from '@/server/visits';

interface Props {
    row: VisitWithProperty;
    index: number;
    featured?: boolean;
}

const { row, index, featured = false } = Astro.props;
const { visit, property, client } = row;
const hasLocation = property.lat != null && property.lng != null;
const duration = formatVisitDuration(visit.startedAt, visit.leftAt ?? visit.completedAt);
---

<li class:list={[
    'min-w-0 rounded-2xl border p-4 shadow-sm sm:p-5',
    featured
        ? 'border-sky-200 bg-gradient-to-br from-sky-50 via-white to-white ring-1 ring-sky-100'
        : 'border-slate-200 bg-white',
]}>
    {featured && (
        <p class="mb-3 text-xs font-extrabold uppercase tracking-wider text-sky-800">
            {visit.status === 'in_progress' ? 'Visita en curso' : 'Siguiente parada'}
        </p>
    )}
    <div class="flex min-w-0 items-start gap-3">
        <span class:list={[
            'flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-sm font-extrabold',
            featured ? 'bg-sky-700 text-white' : 'bg-slate-100 text-slate-600',
        ]}>{index + 1}</span>
        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
                <a href={`/panel/propiedades/${property.id}`}
                    class="max-w-full truncate font-extrabold text-slate-900 hover:underline">
                    {property.alias}
                </a>
                <span class:list={['shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-bold', visitStatusStyle(visit.status)]}>
                    {visitStatusLabel(visit.status)}
                </span>
            </div>
            <p class="mt-1 truncate text-sm text-slate-600">{client.name} · {property.address}</p>
            <p class="mt-1 text-xs font-semibold text-sky-800">{workTypesLabel(visit.workTypes)}</p>
            {(visit.startedAt || visit.leftAt || visit.completedAt) && (
                <p class="mt-1 text-xs text-slate-600">
                    {visit.startedAt && `Llegada ${formatTime(visit.startedAt)}`}
                    {(visit.leftAt ?? visit.completedAt) && ` · Salida ${formatTime(visit.leftAt ?? visit.completedAt!)}`}
                    {duration && ` · ${duration} en propiedad`}
                </p>
            )}
        </div>
    </div>
    <div class:list={['mt-3 grid gap-2', hasLocation ? 'grid-cols-2' : 'grid-cols-1']}>
        <a href={`/panel/visitas/${visit.id}`}
            class:list={[
                'panel-btn min-h-11 w-full px-2 text-xs sm:px-4 sm:text-sm',
                visit.status === 'completed'
                    ? 'panel-btn-secondary'
                    : 'panel-btn-primary',
            ]}>
            {visit.status === 'scheduled' ? 'Iniciar visita' :
                visit.status === 'in_progress' ? 'Continuar visita' : 'Ver registro'}
        </a>
        {hasLocation && (
            <a href={`https://www.google.com/maps/dir/?api=1&destination=${property.lat},${property.lng}&travelmode=driving`}
                target="_blank" rel="noopener noreferrer"
                class="panel-btn panel-btn-secondary min-h-11 w-full px-2 text-xs sm:px-4 sm:text-sm">
                Navegar
            </a>
        )}
    </div>
</li>
