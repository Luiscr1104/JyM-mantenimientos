---
import { formatTime, visitStatusLabel, visitStatusStyle } from '@/lib/format';
import { workTypesLabel } from '@/lib/visit-types';
import type { VisitWithProperty } from '@/server/visits';

interface Props {
    row: VisitWithProperty;
    index: number;
    featured?: boolean;
}

const { row, index, featured = false } = Astro.props;
const { visit, property, client } = row;
const hasLocation = property.lat != null && property.lng != null;
const current = visit.status === 'in_progress';
---

<li class:list={[
    'min-w-0 overflow-hidden rounded-2xl border border-l-4 bg-white shadow-sm transition-colors',
    featured
        ? current ? 'border-amber-200 border-l-amber-500' : 'border-sky-200 border-l-sky-600'
        : 'border-slate-200 border-l-transparent hover:border-sky-200',
]}>
    <details class="group" name="today-stops">
        <summary class="today-stop-summary flex min-h-16 cursor-pointer list-none items-center gap-3 px-3 py-2.5 outline-none hover:bg-slate-50 focus-visible:bg-sky-50 focus-visible:outline-2 focus-visible:outline-sky-700 sm:px-4">
            <span class:list={[
                'flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-sm font-extrabold',
                featured ? current ? 'bg-amber-600 text-white' : 'bg-sky-700 text-white' : 'bg-slate-100 text-slate-600',
            ]}>{index + 1}</span>
            <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-extrabold text-slate-900 sm:text-base">{property.alias}</span>
                <span class="mt-0.5 block truncate text-xs text-slate-500">{client.name}</span>
            </span>
            <span class:list={[
                'shrink-0 rounded-full border px-2 py-1 text-[11px] font-bold',
                featured && visit.status === 'scheduled'
                    ? 'border-sky-200 bg-sky-50 text-sky-800'
                    : visitStatusStyle(visit.status),
            ]}>
                {featured && visit.status === 'scheduled' ? 'Siguiente' : visitStatusLabel(visit.status)}
            </span>
            <span class="shrink-0 text-lg leading-none text-sky-700 transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
        </summary>
        <div class="border-t border-slate-100 px-4 pb-4 pt-3 sm:px-5">
            <p class="text-sm text-slate-700">{property.address}</p>
            <p class="mt-1 text-xs font-semibold text-sky-800">{workTypesLabel(visit.workTypes)}</p>
            {visit.startedAt && <p class="mt-1 text-xs text-slate-600">Llegada {formatTime(visit.startedAt)}</p>}
            <div class:list={['mt-3 grid gap-2', hasLocation ? 'grid-cols-2' : 'grid-cols-1']}>
                <a href={`/panel/visitas/${visit.id}`}
                    class="panel-btn panel-btn-primary min-h-11 w-full px-2 text-xs sm:px-4 sm:text-sm">
                    {visit.status === 'in_progress' ? 'Continuar visita' : 'Iniciar visita'}
                </a>
                {hasLocation && (
                    <a href={`https://www.google.com/maps/dir/?api=1&destination=${property.lat},${property.lng}&travelmode=driving`}
                        target="_blank" rel="noopener noreferrer"
                        class="panel-btn panel-btn-secondary min-h-11 w-full px-2 text-xs sm:px-4 sm:text-sm">
                        Navegar
                    </a>
                )}
            </div>
        </div>
    </details>
</li>

<style is:global>
    .today-stop-summary::-webkit-details-marker {
        display: none;
    }
</style>
