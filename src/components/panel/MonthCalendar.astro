---
import { addMonths, monthGrid } from '@/lib/agenda-calendar';
import { getToday } from '@/lib/dates';

interface Props {
    date: string;
    month: string;
    open: boolean;
    counts: Record<string, number>;
    fromRoute?: boolean;
}

const { date, month, open, counts, fromRoute = false } = Astro.props;
const today = getToday();
const monthLabel = new Intl.DateTimeFormat('es-CR', {
    timeZone: 'UTC', month: 'long', year: 'numeric',
}).format(new Date(`${month}-01T12:00:00Z`));
const monthHref = (value: string) =>
    `/panel/agenda?date=${date}&month=${value}&calendar=month${fromRoute ? '&from=route' : ''}#calendario-mensual`;
const dayHref = (value: string) =>
    `/panel/agenda?date=${value}&calendar=month${fromRoute ? '&from=route' : ''}#gestionar-visitas`;
const weekdays = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
---

<details id="calendario-mensual" open={open}
    class="group mb-5 min-w-0 scroll-mt-20 rounded-2xl border border-slate-200 bg-white shadow-sm">
    <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-2 p-4 text-sm font-extrabold text-sky-800">
        <span class="group-open:hidden">Ver calendario mensual</span>
        <span class="hidden group-open:inline">Ocultar calendario mensual</span>
        <span aria-hidden="true" class="text-slate-500">▾</span>
    </summary>
    <div class="border-t border-slate-100 px-3 pb-4 pt-3 sm:px-5">
        <div class="mb-3 flex items-center justify-between gap-1">
            <a href={monthHref(addMonths(month, -1))} aria-label="Mes anterior"
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-lg font-bold text-slate-700 hover:bg-slate-100">
                ←
            </a>
            <h2 class="text-center text-base font-extrabold capitalize text-slate-900">{monthLabel}</h2>
            <a href={monthHref(addMonths(month, 1))} aria-label="Mes siguiente"
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-lg font-bold text-slate-700 hover:bg-slate-100">
                →
            </a>
        </div>
        {month !== today.slice(0, 7) && (
            <a href={monthHref(today.slice(0, 7))}
                class="mb-2 inline-flex min-h-10 items-center text-xs font-bold text-sky-800 underline">Ir a este mes</a>
        )}
        <div class="grid grid-cols-7 gap-1 text-center">
            {weekdays.map((weekday) => (
                <span class="py-1 text-[11px] font-bold text-slate-500">{weekday}</span>
            ))}
            {monthGrid(month).map((day) => day ? (
                <a href={dayHref(day)}
                    aria-current={day === today ? 'date' : undefined}
                    aria-label={`${Number(day.slice(-2))} de ${monthLabel}: ${counts[day] ?? 0} ${(counts[day] ?? 0) === 1 ? 'visita' : 'visitas'}${day === date ? ', seleccionado' : ''}`}
                    class:list={[
                        'flex min-h-14 min-w-0 flex-col items-center justify-center gap-0.5 rounded-lg border px-0.5 text-sm font-bold transition',
                        day === date ? 'border-sky-600 bg-sky-100 text-sky-900' :
                        day === today ? 'border-sky-300 bg-white text-sky-800' :
                        'border-transparent text-slate-700 hover:bg-slate-100',
                    ]}>
                    <span>{Number(day.slice(-2))}</span>
                    {counts[day] ? (
                        <span class="flex items-center gap-0.5 text-[10px] leading-none text-sky-800">
                            <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-sky-700"></span>
                            {counts[day]}
                        </span>
                    ) : <span aria-hidden="true" class="h-2"></span>}
                </a>
            ) : <span aria-hidden="true"></span>)}
        </div>
        <p class="mt-3 text-xs text-slate-600">
            El punto indica visitas programadas, en curso o completadas; las omitidas no cuentan.
            Toca cualquier fecha para agendar en ese día.
        </p>
    </div>
</details>
