# ---------------------------------------------------------------------------
# JyM Mantenimientos — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# .env.local nunca se sube al repositorio.
# ---------------------------------------------------------------------------

# Públicas (se exponen al navegador; la publishable key está diseñada para eso)
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Solo servidor
# Secret key de Supabase (bypassa RLS; úsala solo en el servidor)
SUPABASE_SECRET_KEY="sb_secret_..."

# Runtime: transaction pooler de Supabase (puerto 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# Migraciones de Drizzle: session pooler de Supabase (puerto 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Aplicación
APP_URL="http://localhost:4321"
APP_TIMEZONE="America/Costa_Rica"

# Semilla del dueño (temporal, borrar después de ejecutar pnpm seed:owner)
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME="Luis"

# Fase 2: rutas
GOOGLE_MAPS_API_KEY=""

# Fase 3: notificaciones push (generar con `pnpm web-push generate-vapid-keys`)
PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto@jymmantenimientos.com"
